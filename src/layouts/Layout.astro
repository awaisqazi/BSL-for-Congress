---
import '../styles/global.css';
import PetitionModal from '../components/PetitionModal.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Byron Sigcho-Lopez for 25th Ward Alderman",
  description = "Byron Sigcho-Lopez is running for a third term as Alderman of Chicago's 25th Ward, home to Pilsen, Heart of Chicago, and Little Village. Seven years of delivering: 800+ affordable units, Ward Night every Tuesday, no developer money since 2015. This summer the machine's lawyers kept his name off a congressional ballot. The ward is a different story. Election day: February 23, 2027."
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Absolute URLs for link previews (iMessage/social scrapers ignore relative og: URLs)
const ogImage = new URL(`${base}/images/og-card.png`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Byron Sigcho-Lopez for 25th Ward Alderman" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Byron Sigcho-Lopez, Alderman 25th Ward. Re-election, February 23, 2027." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    <!-- Styles loaded via import in frontmatter -->
  </head>
  <body data-base={base}>
    <slot />
    <PetitionModal />
    
    <!-- i18n + shared motion engine (reveals, count-ups, timeline, tickers) -->
    <script>
      import { initI18n } from '../i18n/i18n.js';
      import { initMotion } from '../scripts/motion.js';

      document.addEventListener('DOMContentLoaded', () => {
        initI18n();
        initMotion();
      });
    </script>
  </body>
</html>
