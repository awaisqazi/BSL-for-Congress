---
// The Lobby Day bus, side view, facing right. Decorative everywhere it is used.
interface Props {
  class?: string;
  width?: number;
}
const { class: cls, width = 44 } = Astro.props;
---

<svg class={cls} width={width} height={Math.round((width * 26) / 48)} viewBox="0 0 48 26" aria-hidden="true" focusable="false">
  <path d="M3 4.5A2.5 2.5 0 0 1 5.5 2h31.2c2 0 3.6 1 4.6 2.7l3.6 6.2c.7 1.2 1.1 2.6 1.1 4V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" fill="var(--bus-body, #e6881c)" />
  <path d="M3 15.5h42.4V17H3z" fill="var(--bus-stripe, #142749)" opacity="0.85" />
  <rect x="6" y="5" width="6.5" height="6" rx="1" fill="var(--bus-glass, #fef5e6)" />
  <rect x="14.5" y="5" width="6.5" height="6" rx="1" fill="var(--bus-glass, #fef5e6)" />
  <rect x="23" y="5" width="6.5" height="6" rx="1" fill="var(--bus-glass, #fef5e6)" />
  <path d="M31.5 5h5c.9 0 1.7.5 2.2 1.3l2.4 4.2a.3.3 0 0 1-.3.5h-9.3z" fill="var(--bus-glass, #fef5e6)" />
  <circle cx="12" cy="21" r="4" fill="var(--bus-wheel, #142749)" />
  <circle cx="12" cy="21" r="1.6" fill="var(--bus-glass, #fef5e6)" />
  <circle cx="37" cy="21" r="4" fill="var(--bus-wheel, #142749)" />
  <circle cx="37" cy="21" r="1.6" fill="var(--bus-glass, #fef5e6)" />
  <rect x="43" y="12.5" width="2.4" height="2" rx="0.6" fill="#f5d08a" />
</svg>
