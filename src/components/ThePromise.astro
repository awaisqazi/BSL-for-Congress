---
// The Promise Kept: the raised-hands story from the announcement, paid off
// by the full PromiseCounter.
import PromiseCounter from './PromiseCounter.astro';

const fists = Array.from({ length: 9 });
---

<section class="promise section-padding" id="the-promise">
  <div class="container promise-content">
    <span class="section-label animate-in" data-i18n="promise.label">The Promise Kept</span>
    <h2 class="section-title promise-headline animate-in" data-i18n="promise.headline">They Said It Couldn't Be Done.</h2>

    <div class="promise-story">
      <p class="promise-beat animate-in" data-i18n="promise.beat1">
        Illinois law demanded 10,816 valid signatures from an independent. The machine's candidate needed 697.
      </p>
      <p class="promise-beat animate-in" data-i18n="promise.beat2">
        At the announcement, a reporter asked if it was even possible. The room raised its hands before Byron could answer.
      </p>
      <div class="promise-fists animate-in" aria-hidden="true">
        {fists.map((_, i) => (
          <span class="promise-fist" style={`--fist-delay: ${0.2 + i * 0.08}s`}>✊</span>
        ))}
      </div>
      <blockquote class="promise-quote animate-in">
        <span data-i18n="promise.quote">"We'll exceed the 10,000. Easily. At least 20,000."</span>
        <cite class="promise-cite" data-i18n="promise.cite">Shouted from the room at the announcement</cite>
      </blockquote>
    </div>

    <PromiseCounter variant="full" />

    <p class="promise-close animate-in" data-i18n="promise.close">
      They did not beat this at the doors. Their lawyers challenged signatures until the count fell 1,222 short of 10,816, and the rule that let them do it is now being challenged in federal court. On February 23, 2027, the 25th Ward votes, and objections do not count. Voters do.
    </p>

    <a href="#petition" class="btn btn-orange btn-massive animate-in promise-cta" data-i18n="promise.cta">Stand With the 25th Ward</a>
  </div>
</section>

<style>
  .promise {
    background: var(--cream-light);
    border-top: 4px solid var(--blue);
  }

  .promise-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--blue-deeper);
  }

  .promise-headline {
    margin-bottom: var(--space-xl);
  }

  .promise-story {
    max-width: 680px;
    margin-bottom: var(--space-3xl);
  }

  .promise-beat {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--gray-700);
    margin-bottom: var(--space-md);
  }

  .promise-fists {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    font-size: var(--text-3xl);
    margin: var(--space-lg) 0;
  }

  .promise-fist {
    display: inline-block;
    opacity: 0;
    translate: 0 18px;
  }

  .promise-fists.visible .promise-fist {
    animation: promise-rise 0.45s var(--ease-out-back) forwards;
    animation-delay: var(--fist-delay, 0.2s);
  }

  @keyframes promise-rise {
    to { opacity: 1; translate: 0 0; }
  }

  .promise-quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 900;
    line-height: 1.3;
    color: var(--orange-dark);
  }

  .promise-cite {
    display: block;
    margin-top: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gray-500);
  }

  .promise-close {
    max-width: 680px;
    margin-top: var(--space-3xl);
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--gray-700);
  }

  .promise-cta {
    margin-top: var(--space-xl);
  }

  @media (max-width: 768px) {
    .promise-fists { font-size: var(--text-2xl); gap: 6px; }
    .promise-quote { font-size: var(--text-xl); }
  }

  @media (prefers-reduced-motion: reduce) {
    .promise-fist { opacity: 1; translate: 0 0; }
  }
</style>
