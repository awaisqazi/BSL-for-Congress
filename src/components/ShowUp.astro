---
// Home: right under the hero, the next three shifts from src/data/events.json
// as big taped flyers with one orange button each, then the two standing
// shifts and the canvass team form. Up to six upcoming cards ship; the
// script drops any that passed since the last deploy and shows the first three.
import EventCard from './EventCard.astro';
import { upcoming, recurring } from '../data/events.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const candidates = upcoming().slice(0, 6);
const tilts = ['-0.6deg', '0.5deg', '-0.4deg'];
const wardNight = recurring.find((e) => e.kind === 'wardnight');
const sundays = recurring.find((e) => e.kind === 'canvass');
const TEAM_FORM = 'https://forms.gle/aBc3EsoUhraW2A4Q8';
---

<section class="showup section-padding" id="show-up">
  <div class="container">
    <div class="showup-head">
      <div>
        <span class="section-label animate-in" data-i18n="events.label">Show Up</span>
        <h2 class="section-title animate-in" data-i18n="events.headline">The Next Doors We Knock</h2>
        <p class="showup-sub animate-in" data-i18n="events.sub">Pick a shift and bring a neighbor. Every signature on the petition is a neighbor's name.</p>
      </div>
      <a href={`${base}/events/`} class="showup-all animate-in">
        <span data-i18n="events.all_link">See every date</span> <span class="showup-all-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <ul class="showup-grid" data-showup-list>
      {candidates.map((e, i) => (
        <EventCard event={e} signupHref={`${base}/volunteer#signup`} tilt={tilts[i % 3]} delay={i * 0.08} hidden={i >= 3} pulse={i === 0} />
      ))}
    </ul>
    <p class="showup-empty" data-showup-empty hidden={candidates.length > 0 ? true : undefined} data-i18n="events.empty">No dated shifts are posted right now. The standing shifts below keep going.</p>

    <div class="showup-standing">
      {wardNight && (
        <a class="showup-chip animate-in" href={wardNight.link} target="_blank" rel="noopener">
          <span class="showup-chip-day" aria-hidden="true">
            <span data-lang="en">Tue</span><span data-lang="es" hidden>mar</span>
          </span>
          <span class="showup-chip-text" data-i18n="events.standing_wardnight">Ward Night, every Tuesday</span>
          <span class="showup-chip-arrow" aria-hidden="true">→</span>
        </a>
      )}
      {sundays && (
        <a class="showup-chip animate-in" href={sundays.link} target="_blank" rel="noopener">
          <span class="showup-chip-day" aria-hidden="true">
            <span data-lang="en">Sun</span><span data-lang="es" hidden>dom</span>
          </span>
          <span class="showup-chip-text" data-i18n="events.standing_sunday">Sunday canvasses: find your shift</span>
          <span class="showup-chip-arrow" aria-hidden="true">→</span>
        </a>
      )}
    </div>

    <p class="showup-team animate-in">
      <a href={TEAM_FORM} target="_blank" rel="noopener" data-i18n="events.team_link">Can't make these? Join the canvass team</a>
    </p>
  </div>
</section>

<script>
  import { pruneList, watchCountdowns } from '../scripts/events-client.js';

  const list = document.querySelector('[data-showup-list]');
  const left = pruneList(list, 3);
  if (!left) {
    list?.remove();
    const empty = document.querySelector('[data-showup-empty]');
    if (empty) empty.hidden = false;
  }
  watchCountdowns();
</script>

<style>
  .showup {
    background: var(--cream);
  }

  .showup-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .showup-head .section-label {
    display: block;
  }

  .showup-head .section-title {
    margin-bottom: var(--space-sm);
  }

  .showup-sub {
    max-width: 620px;
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--gray-700);
  }

  .showup-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--blue-dark);
  }

  .showup-all span:first-child {
    border-bottom: 2px dashed rgba(3, 109, 153, 0.4);
    padding-bottom: 2px;
  }

  .showup-all:hover {
    color: var(--orange-dark);
  }

  .showup-all-arrow,
  .showup-chip-arrow {
    transition: translate var(--duration-fast) var(--ease-default);
  }

  .showup-all:hover .showup-all-arrow,
  .showup-chip:hover .showup-chip-arrow {
    translate: 4px 0;
  }

  .showup-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
    align-items: stretch;
    padding: 0;
  }

  .showup-empty {
    margin-top: var(--space-2xl);
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--blue-deeper);
    text-align: center;
  }

  .showup-empty[hidden] {
    display: none;
  }

  /* Standing shifts: two compact taped chips */
  .showup-standing {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .showup-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 52px;
    padding: 8px 18px 8px 8px;
    background: var(--cream-light);
    border: 2px dashed rgba(27, 54, 93, 0.3);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--blue-deeper);
    transition: border-color var(--duration-fast) var(--ease-default), color var(--duration-fast) var(--ease-default);
  }

  .showup-chip:hover {
    border-color: var(--orange-dark);
    color: var(--orange-dark);
  }

  .showup-chip-day {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--blue-deeper);
    color: var(--cream-light);
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  .showup-team {
    margin-top: var(--space-lg);
    text-align: center;
  }

  .showup-team a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--blue-dark);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  .showup-team a:hover {
    color: var(--orange-dark);
  }

  @media (max-width: 1024px) {
    .showup-grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
      gap: var(--space-2xl);
    }
  }

  @media (max-width: 768px) {
    .showup-head {
      align-items: flex-start;
    }

    .showup-standing {
      flex-direction: column;
      align-items: stretch;
    }

    .showup-chip {
      justify-content: flex-start;
    }

    .showup-chip-arrow {
      margin-left: auto;
    }
  }
</style>
