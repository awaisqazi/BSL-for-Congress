---
// The Promise Kept, drawn as four bars: their candidate's 697, the law's
// 10,816, the room's promised 20,000 (dashed outline), and the movement's
// 22,788 sweeping past them all. Numbers are literals outside data-i18n;
// labels translate.
export interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;

const MAX = 22788;
const rows = [
  { value: 697, display: '697', key: 'counter.marker_machine', label: "What their candidate needed", kind: 'machine' },
  { value: 10816, display: '10,816', key: 'counter.marker_law', label: "What the law demanded of Byron", kind: 'law' },
  { value: 20000, display: '20,000+', key: 'counter.marker_promise', label: "The room's promise", kind: 'promise' },
  { value: 22788, display: '22,788', key: 'counter.marker_delivered', label: "What the movement delivered", kind: 'delivered' },
];
---

<div class={`promise-counter animate-in ${variant === 'compact' ? 'pc-compact' : ''}`}>
  {variant === 'full' && (
    <div class="pc-readout">
      <span class="pc-number stat-tabular">22,788</span>
      <span class="pc-readout-label" data-i18n="counter.readout_label">valid signatures filed with the Illinois State Board of Elections. The record stands.</span>
    </div>
  )}

  <div class="pc-chart" role="img" aria-label="Bar chart: their candidate needed 697 signatures, the law demanded 10,816 from Byron, the room promised at least 20,000, and the movement delivered 22,788.">
    {rows.map((row, i) => (
      <div class={`pc-row pc-row-${row.kind}`}>
        <span class="pc-row-label" data-i18n={row.key}>{row.label}</span>
        <div class="pc-row-track">
          <div class="pc-row-bar" style={`--bar: ${(row.value / MAX) * 100}%; --bar-delay: ${0.15 + i * 0.3}s`}></div>
        </div>
        <span class="pc-row-value stat-tabular" style={`--bar-delay: ${0.15 + i * 0.3}s`}>{row.display}</span>
      </div>
    ))}
  </div>

  {variant === 'full' && (
    <p class="pc-caption" data-i18n="counter.caption">Promise made. Promise kept. Then erased by lawyers, never by voters.</p>
  )}
</div>

<style>
  .promise-counter {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
  }

  .pc-readout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .pc-number {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 900;
    line-height: 1;
    color: var(--orange);
    text-shadow: 0 2px 24px rgba(230, 136, 28, 0.25);
  }

  .pc-readout-label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: inherit;
    opacity: 0.85;
  }

  .pc-chart {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Label | track | value as separate grid columns so bar widths stay
     mathematically true (a flex row let wide value text shrink its bar) */
  .pc-row {
    display: grid;
    grid-template-columns: 200px 1fr 84px;
    align-items: center;
    gap: var(--space-md);
  }

  .pc-row-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-align: right;
    color: inherit;
    opacity: 0.85;
  }

  .pc-row-track {
    height: 34px;
  }

  .pc-row-bar {
    width: var(--bar);
    height: 100%;
    border-radius: 6px;
    transform: scaleX(0);
    transform-origin: left;
  }

  .visible .pc-row-bar {
    animation: pc-bar-grow 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--bar-delay) forwards;
  }

  @keyframes pc-bar-grow {
    to { transform: scaleX(1); }
  }

  .pc-row-value {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 900;
    line-height: 1;
    color: inherit;
    opacity: 0;
    white-space: nowrap;
  }

  .visible .pc-row-value {
    animation: pc-value-in 0.4s var(--ease-default) var(--bar-delay) forwards;
  }

  @keyframes pc-value-in {
    to { opacity: 1; }
  }

  /* Bar treatments */
  .pc-row-machine .pc-row-bar {
    background: var(--gray-500);
    min-width: 10px;
  }

  .pc-row-law .pc-row-bar {
    background: var(--blue-deeper);
  }

  .pc-row-promise .pc-row-bar {
    background: transparent;
    border: 2.5px dashed rgba(230, 136, 28, 0.75);
  }

  .pc-row-promise .pc-row-label,
  .pc-row-promise .pc-row-value {
    color: var(--orange-dark);
    opacity: 1;
  }

  .pc-row-delivered .pc-row-bar {
    background: linear-gradient(90deg, var(--orange-dark), var(--orange), var(--orange-light));
    box-shadow: 0 2px 16px rgba(230, 136, 28, 0.35);
  }

  .pc-row-delivered .pc-row-label {
    opacity: 1;
    font-weight: 900;
  }

  .pc-row-delivered .pc-row-value {
    font-size: var(--text-2xl);
    color: var(--orange);
  }

  .pc-caption {
    margin-top: var(--space-2xl);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    text-align: center;
    color: inherit;
  }

  .pc-compact .pc-chart {
    gap: var(--space-md);
  }

  .pc-compact .pc-row-track {
    height: 26px;
  }

  @media (max-width: 768px) {
    .pc-row {
      grid-template-columns: 1fr 72px;
      gap: 6px var(--space-sm);
    }

    .pc-row-label {
      grid-column: 1 / -1;
      text-align: left;
    }

    .pc-row-track {
      height: 28px;
    }

    .pc-row-value {
      font-size: var(--text-base);
    }

    .pc-row-delivered .pc-row-value {
      font-size: var(--text-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-row-bar { transform: scaleX(1); }
    .pc-row-value { opacity: 1; }
  }
</style>
