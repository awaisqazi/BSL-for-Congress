---
// The Promise Kept arc: 697 (their bar) -> 10,816 (the law's bar) ->
// 20,000 (the room's promise) -> 22,788 (the movement's answer).
// Numbers are literals outside data-i18n; labels translate.
export interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;

const MAX = 22788;
const markers = [
  { value: 697, key: 'counter.marker_machine', label: "Their candidate's bar" },
  { value: 10816, key: 'counter.marker_law', label: "The law's bar for Byron" },
  { value: 20000, key: 'counter.marker_promise', label: "The room's promise" },
  { value: 22788, key: 'counter.marker_delivered', label: "The movement's answer" },
];
---

<div class={`promise-counter animate-in ${variant === 'compact' ? 'pc-compact' : ''}`}>
  <div class="pc-readout">
    <span class="pc-number stat-tabular" data-countup="22788" data-countup-duration="2500">22,788</span>
    <span class="pc-readout-label" data-i18n="counter.readout_label">valid signatures filed with the State Board of Elections</span>
  </div>

  <div class="pc-road" role="img" aria-label="Progress bar showing 22,788 signatures filed, passing the 697 their candidate needed, the 10,816 the law demanded, and the 20,000 the room promised.">
    <div class="pc-track"></div>
    <div class="pc-fill"></div>
    {markers.map((m) => (
      <div class="pc-marker" style={`left: ${(m.value / MAX) * 100}%`}>
        <span class="pc-marker-tick"></span>
        <span class="pc-marker-value stat-tabular">{m.value.toLocaleString('en-US')}</span>
        <span class="pc-marker-label" data-i18n={m.key}>{m.label}</span>
      </div>
    ))}
  </div>

  {variant === 'full' && (
    <p class="pc-caption" data-i18n="counter.caption">Promise made. Promise kept. More than double the law's demand.</p>
  )}
</div>

<style>
  .promise-counter {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .pc-readout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin-bottom: var(--space-2xl);
  }

  .pc-number {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 900;
    line-height: 1;
    color: var(--orange);
    text-shadow: 0 2px 24px rgba(230, 136, 28, 0.25);
  }

  .pc-readout-label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: inherit;
    opacity: 0.85;
  }

  .pc-road {
    position: relative;
    height: 10px;
    margin: 0 var(--space-xl) var(--space-3xl);
  }

  .pc-track {
    position: absolute;
    inset: 0;
    background: rgba(3, 109, 153, 0.18);
    border-radius: 100px;
  }

  .pc-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--orange-dark), var(--orange), var(--orange-light));
    border-radius: 100px;
    transform: scaleX(0);
    transform-origin: left;
  }

  .visible .pc-fill {
    animation: pc-fill-grow 2.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes pc-fill-grow {
    to { transform: scaleX(1); }
  }

  .pc-marker {
    position: absolute;
    top: 50%;
    width: 0;
  }

  .pc-marker-tick {
    position: absolute;
    left: -1.5px;
    top: -14px;
    width: 3px;
    height: 28px;
    border-radius: 2px;
    background: var(--blue-deeper);
    opacity: 0;
    scale: 0.4;
  }

  .visible .pc-marker-tick {
    animation: pc-pop 0.4s var(--ease-out-back) forwards;
  }

  .pc-marker-value {
    position: absolute;
    top: -42px;
    left: 0;
    translate: -50% 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 900;
    color: inherit;
    opacity: 0;
  }

  .pc-marker-label {
    position: absolute;
    top: 20px;
    left: 0;
    translate: -50% 0;
    width: 110px;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.3;
    color: inherit;
    opacity: 0;
  }

  .visible .pc-marker-value,
  .visible .pc-marker-label {
    animation: pc-fade 0.5s var(--ease-default) forwards;
  }

  @keyframes pc-pop {
    to { opacity: 1; scale: 1; }
  }

  @keyframes pc-fade {
    to { opacity: 0.9; }
  }

  /* Stagger the marker reveals to ride the fill sweep */
  .pc-marker:nth-child(3) .pc-marker-tick,
  .pc-marker:nth-child(3) .pc-marker-value,
  .pc-marker:nth-child(3) .pc-marker-label { animation-delay: 0.15s; }
  .pc-marker:nth-child(4) .pc-marker-tick,
  .pc-marker:nth-child(4) .pc-marker-value,
  .pc-marker:nth-child(4) .pc-marker-label { animation-delay: 1.2s; }
  .pc-marker:nth-child(5) .pc-marker-tick,
  .pc-marker:nth-child(5) .pc-marker-value,
  .pc-marker:nth-child(5) .pc-marker-label { animation-delay: 2.0s; }
  .pc-marker:nth-child(6) .pc-marker-tick,
  .pc-marker:nth-child(6) .pc-marker-value,
  .pc-marker:nth-child(6) .pc-marker-label { animation-delay: 2.35s; }

  .pc-marker:nth-child(6) .pc-marker-tick { background: var(--orange-dark); }
  .pc-marker:nth-child(6) .pc-marker-value { font-size: var(--text-sm); }

  .pc-caption {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    color: inherit;
  }

  .pc-compact .pc-number { font-size: var(--text-4xl); }
  .pc-compact .pc-road { margin-bottom: var(--space-2xl); }
  .pc-compact .pc-readout { margin-bottom: var(--space-xl); }

  @media (max-width: 768px) {
    .pc-road { margin-left: var(--space-md); margin-right: var(--space-md); }
    .pc-marker-label { width: 72px; font-size: 0.55rem; }
    /* The two left markers crowd on small screens; keep ticks, hide their text */
    .pc-marker:nth-child(3) .pc-marker-value,
    .pc-marker:nth-child(3) .pc-marker-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pc-fill { transform: scaleX(1); }
    .pc-marker-tick { opacity: 1; scale: 1; }
    .pc-marker-value, .pc-marker-label { opacity: 0.9; }
  }
</style>
