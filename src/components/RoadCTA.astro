---
// Shared closing band: every page ends on the same road and the same fork.
---

<section class="road-cta">
  <div class="road-cta-bg"></div>
  <div class="container road-cta-content">
    <svg class="road-line animate-in" viewBox="0 0 600 70" preserveAspectRatio="none" aria-hidden="true">
      <path class="road-path" d="M0 60 C 150 60, 200 20, 300 22 S 480 50, 600 14" pathLength="1" />
      <path class="road-dash" d="M0 60 C 150 60, 200 20, 300 22 S 480 50, 600 14" pathLength="1" />
    </svg>

    <blockquote class="road-quote animate-in">
      <span data-i18n="road.quote">Justice is not a destination. It is the road that is traveled.</span>
      <cite class="road-cite">Byron Sigcho-Lopez</cite>
    </blockquote>

    <p class="road-lead animate-in" data-i18n="road.lead">Round one went to their lawyers. Round two is the ballot box, February 23, 2027.</p>

    <div class="road-buttons animate-in">
      <a href="#petition" class="btn btn-orange btn-massive" data-i18n="road.cta_join">Join the Fight</a>
      <a href="https://secure.actblue.com/donate/byron-sigcho-1" class="btn btn-cream" target="_blank" rel="noopener" data-i18n="road.cta_donate">Chip in $27</a>
    </div>
  </div>
</section>

<style>
  .road-cta {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: hidden;
  }

  .road-cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, var(--blue) 0%, var(--blue-deeper) 85%);
    z-index: 0;
  }

  .road-cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    text-align: center;
  }

  .road-line {
    width: min(600px, 88%);
    height: 70px;
    overflow: visible;
  }

  .road-path {
    fill: none;
    stroke: rgba(254, 245, 230, 0.25);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .road-dash {
    fill: none;
    stroke: var(--gold-soft);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 0.04 0.045;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.65, 0, 0.35, 1) 0.15s;
  }

  .road-line.visible .road-path,
  .road-line.visible .road-dash {
    stroke-dashoffset: 0;
  }

  .road-quote {
    margin: 0;
    max-width: 720px;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 900;
    line-height: 1.2;
    color: var(--cream);
  }

  .road-cite {
    display: block;
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--gold-soft);
  }

  .road-lead {
    font-size: var(--text-xl);
    color: #ffffff;
    font-weight: 500;
  }

  .road-buttons {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .road-quote { font-size: var(--text-2xl); }
    .road-buttons { flex-direction: column; width: 100%; }
    .road-buttons .btn { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .road-path, .road-dash { stroke-dashoffset: 0; }
  }
</style>
