---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" id="hero">
  <!-- Video Background -->
  <div class="hero-video-bg">
    <div class="hero-video-container" id="heroVideoContainer">
      <video
        id="heroVideo"
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={`${base}/video/hero-poster.jpg`}
        aria-hidden="true"
        data-src-loop={`${base}/video/hero-loop.mp4`}
        data-src-sound={`${base}/video/hero-sound.mp4`}
      >
        <source src={`${base}/video/hero-loop.mp4`} type="video/mp4" />
      </video>
    </div>
    <!-- Gradient Overlay -->
    <div class="hero-gradient-overlay" id="heroGradientOverlay"></div>
  </div>

  <!-- Content Overlay -->
  <div class="hero-content-overlay" id="heroContentOverlay">
    <div class="hero-content container">
      <span class="hero-badge animate-in anim-stamp" style="--tilt: -1deg; --reveal-delay: 0.45s" data-i18n="hero.badge">RE-ELECT BYRON SIGCHO-LOPEZ • 25TH WARD ALDERMAN</span>

      <h1 class="hero-narrative animate-in" style="--reveal-delay: 0s">
        <span data-i18n="hero.narrative_lead">Your alderman since 2019. Seven years of receipts, and the work is not finished. A third term for</span>
        <strong class="hero-tagline-highlight" data-i18n="hero.tagline">the 25th Ward.</strong>
      </h1>

      <p class="hero-narrative-secondary animate-in" style="--reveal-delay: 0.2s" data-i18n="hero.narrative_run">
        Byron Sigcho-Lopez is running for a third term as Alderman of the 25th Ward: Pilsen, Little Village, Heart of Chicago, Marshall Square, and University Village. The campaign launched August 18, 2026 in Pilsen.
      </p>

      <a href={`${base}/volunteer#signup`} class="btn btn-orange btn-massive hero-cta animate-in" style="--reveal-delay: 0.35s" data-i18n="hero.cta">
        Knock Doors With Us
      </a>

      <p class="hero-summary animate-in" style="--reveal-delay: 0.5s" data-i18n="hero.summary">
        Over 800 units of affordable housing. Ward Night every Tuesday for seven years, including through the pandemic. Not one dollar from developers or corporate PACs since 2015. This summer the machine's lawyers kept his name off a congressional ballot. The ward is a different story, and on February 23 the neighbors decide it.
      </p>

      <div class="hero-receipts animate-in" style="--reveal-delay: 0.6s">
        <div class="hero-receipt">
          <span class="hero-receipt-number stat-tabular">800+</span>
          <span class="hero-receipt-label" data-i18n="hero.chip_units">affordable units</span>
        </div>
        <div class="hero-receipt">
          <span class="hero-receipt-number stat-tabular">$500K+</span>
          <span class="hero-receipt-label" data-i18n="hero.chip_safety">violence prevention</span>
        </div>
        <div class="hero-receipt">
          <span class="hero-receipt-number stat-tabular">$1M+</span>
          <span class="hero-receipt-label" data-i18n="hero.chip_schools">for ward schools</span>
        </div>
        <div class="hero-receipt hero-receipt-win">
          <span class="hero-receipt-number stat-tabular">$0</span>
          <span class="hero-receipt-label" data-i18n="hero.chip_money">from developers or PACs</span>
        </div>
      </div>

      <div class="hero-urgency animate-in anim-stamp" style="--tilt: -1.5deg; --reveal-delay: 0.75s">
        <span data-i18n="hero.urgency_label">Election day February 23.</span>
        <span class="hero-urgency-day stat-tabular" data-days-until="2027-02-23">149</span>
        <span data-i18n="hero.urgency_label2">days to go.</span>
      </div>
    </div>

    <a href="#the-promise" class="hero-scroll-cue animate-in" style="--reveal-delay: 1s" aria-label="Scroll to the story">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
    </a>
  </div>

  <!-- Sound Toggle Button (outside content overlay so it stays visible) -->
  <button class="hero-sound-btn" id="heroSoundBtn" aria-label="Watch with sound">
    <svg class="sound-icon sound-icon-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
      <path d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/>
    </svg>
    <svg class="sound-icon sound-icon-on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
      <path d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/>
      <path d="M15.536 8.464a5 5 0 010 7.072"/>
      <path d="M18.364 5.636a9 9 0 010 12.728"/>
    </svg>
    <span class="sound-label" id="heroSoundLabel" data-i18n="hero.sound_watch">Watch with Sound</span>
  </button>
</section>

<script>
  import en from '../i18n/en.json';
  import es from '../i18n/es.json';
  import { daysUntil } from '../scripts/motion.js';

  const dict = () => ((localStorage.getItem('bsl-lang') || 'en') === 'es' ? es : en);

  // "1 days to go" on the eve of the election; re-run after language toggles.
  function fixHeroDayWord() {
    const num = document.querySelector('.hero-urgency-day[data-days-until]');
    const label = document.querySelector('[data-i18n="hero.urgency_label2"]');
    if (!num || !label) return;
    if (daysUntil(num.getAttribute('data-days-until')) === 1) label.textContent = dict().hero.urgency_label2_one;
  }
  fixHeroDayWord();
  document.addEventListener('bsl:langchange', () => setTimeout(fixHeroDayWord, 0));

  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('heroSoundBtn');
    const iconOff = document.querySelector('.sound-icon-off') as HTMLElement;
    const iconOn = document.querySelector('.sound-icon-on') as HTMLElement;
    const label = document.getElementById('heroSoundLabel');
    const contentOverlay = document.getElementById('heroContentOverlay');
    const gradientOverlay = document.getElementById('heroGradientOverlay');
    const videoContainer = document.getElementById('heroVideoContainer');
    const video = document.getElementById('heroVideo') as HTMLVideoElement | null;
    const loopSrc = video?.dataset.srcLoop || '';
    const soundSrc = video?.dataset.srcSound || '';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let isMuted = true;

    // Point the element at a new file (the <source> child is dropped so
    // the src attribute is the only candidate) and reload.
    const setSource = (src: string) => {
      if (!video) return;
      video.querySelectorAll('source').forEach((el) => el.remove());
      video.src = src;
      video.load();
    };

    const tryPlay = () => {
      video?.play().catch(() => { /* autoplay blocked: the poster stays up */ });
    };

    // Muted background loop. Reduced motion keeps the poster instead.
    const startBackground = () => {
      if (!video) return;
      if (reduceMotion.matches) {
        video.pause();
        video.removeAttribute('autoplay');
        return;
      }
      tryPlay();
    };
    startBackground();

    // Some browsers reject the first muted play() before the file is ready or until the
    // page is interacted with; retry on readiness and on the first gesture, loop mode only.
    const retryPlay = () => {
      if (video && isMuted && video.paused && !reduceMotion.matches) tryPlay();
    };
    video?.addEventListener('canplay', retryPlay);
    ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach((ev) =>
      window.addEventListener(ev, retryPlay, { once: true, passive: true })
    );
    document.addEventListener('visibilitychange', () => { if (!document.hidden) retryPlay(); });

    // Keep the visible label and the accessible name in the current language
    // and the current state (i18n.js rewrites the span on every toggle).
    const syncLabel = () => {
      const text = isMuted ? dict().hero.sound_watch : dict().hero.sound_return;
      if (label) label.textContent = text;
      btn?.setAttribute('aria-label', text);
      btn?.setAttribute('aria-pressed', String(!isMuted));
    };
    document.addEventListener('bsl:langchange', () => setTimeout(syncLabel, 0));

    const enterSound = () => {
      isMuted = false;
      if (iconOff) iconOff.style.display = 'none';
      if (iconOn) iconOn.style.display = 'block';
      syncLabel();

      contentOverlay?.classList.add('faded-out');
      gradientOverlay?.classList.add('faded-out');
      videoContainer?.classList.add('video-watching');

      if (video) {
        video.loop = false;
        video.muted = false;
        video.controls = true;
        video.removeAttribute('aria-hidden');
        setSource(soundSrc);
        video.currentTime = 0;
        tryPlay();
      }
    };

    const exitSound = () => {
      isMuted = true;
      if (iconOff) iconOff.style.display = 'block';
      if (iconOn) iconOn.style.display = 'none';
      syncLabel();

      contentOverlay?.classList.remove('faded-out');
      gradientOverlay?.classList.remove('faded-out');
      videoContainer?.classList.remove('video-watching');

      if (video) {
        video.controls = false;
        video.muted = true;
        video.loop = true;
        video.setAttribute('aria-hidden', 'true');
        setSource(loopSrc);
        startBackground();
      }
    };

    btn?.addEventListener('click', () => {
      if (isMuted) enterSound();
      else exitSound();
    });

    // When the sound copy finishes, fall back to the muted loop.
    video?.addEventListener('ended', () => {
      if (!isMuted) exitSound();
    });
  });
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 620px;
    overflow: hidden;
    background: #0a0a0a;
  }

  /* ── Video Background Layer ── */
  .hero-video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Self-hosted loop, cover-filled. The frame's story (placards, receipts,
     end panel) lives on the right two thirds, so desktop keeps it centred
     and mobile shifts the window onto Byron's paper card on the left. */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    background: #0a1a2e;
    pointer-events: none; /* Background video is decoration only */
  }

  /* Watching mode: the sound copy fits inside the viewport on navy */
  .hero-video-container.video-watching {
    background: #0a1a2e;
    padding: calc(var(--nav-height) + var(--space-md)) var(--space-2xl) calc(var(--space-2xl) + 48px);
  }

  .hero-video-container.video-watching .hero-video {
    position: relative;
    object-fit: contain;
    object-position: 50% 50%;
    pointer-events: auto; /* Controls are live */
  }

  /* ── Gradient Overlay ── */
  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 0.92) 0%,
      rgba(10, 10, 10, 0.7) 20%,
      rgba(3, 80, 120, 0.5) 50%,
      rgba(5, 173, 237, 0.3) 80%,
      rgba(5, 173, 237, 0.15) 100%
    );
    transition: opacity 0.5s ease;
    z-index: 1;
  }

  .hero-gradient-overlay.faded-out {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Content Overlay ── */
  .hero-content-overlay {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: calc(var(--nav-height) + var(--space-2xl)) var(--space-lg) var(--space-2xl);
    text-align: center;
    transition: opacity 0.5s ease;
  }

  .hero-content-overlay.faded-out {
    opacity: 0;
    pointer-events: none;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    max-width: 900px;
    padding: var(--space-lg) var(--space-lg);
  }

  .hero-badge {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--cream);
    background: rgba(230, 136, 28, 0.3);
    border: 1px solid rgba(230, 136, 28, 0.5);
    padding: 6px 16px;
    border-radius: 100px;
    backdrop-filter: blur(4px);
  }

  .hero-narrative {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.45;
    color: var(--cream);
    max-width: 880px;
    margin: 0;
    text-shadow:
      0 1px 4px rgba(0,0,0,0.55),
      0 2px 14px rgba(0,0,0,0.35);
  }

  .hero-tagline-highlight {
    display: inline;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--orange, #e6881c);
    text-shadow:
      0 2px 8px rgba(0,0,0,0.6),
      0 4px 20px rgba(0,0,0,0.4);
  }

  .hero-narrative-secondary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: 1.55;
    color: rgba(251, 226, 186, 0.9);
    max-width: 820px;
    margin: 0;
    text-shadow:
      0 1px 4px rgba(0,0,0,0.5),
      0 2px 12px rgba(0,0,0,0.3);
  }

  .hero-cta {
    margin-top: var(--space-md);
    font-size: var(--text-2xl) !important;
    padding: var(--space-lg) var(--space-3xl) !important;
  }

  .hero-summary {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(251, 226, 186, 0.9);
    max-width: 720px;
    margin-top: var(--space-sm);
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
  }

  /* ── Receipt chips ── */
  .hero-receipts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .hero-receipt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 18px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(251, 226, 186, 0.25);
    border-radius: var(--radius-md);
  }

  .hero-receipt-number {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 900;
    line-height: 1;
    color: var(--cream);
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }

  .hero-receipt-label {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(251, 226, 186, 0.8);
    white-space: nowrap;
  }

  .hero-receipt-win {
    border-color: rgba(230, 136, 28, 0.7);
    background: rgba(230, 136, 28, 0.22);
  }

  .hero-receipt-win .hero-receipt-number {
    color: var(--orange-light);
  }

  /* ── Urgency stamp ── */
  .hero-urgency {
    display: inline-block;
    line-height: 1.3;
    margin-top: var(--space-sm);
    padding: 5px 14px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #ffb09c;
    border: 2.5px solid rgba(255, 107, 74, 0.8);
    border-radius: 4px;
    background: rgba(20, 10, 8, 0.35);
    backdrop-filter: blur(4px);
  }

  /* Spans flow inline (the markup's spaces separate them) so the number
     shares the label's baseline; each span stays whole if the stamp wraps. */
  .hero-urgency > span {
    white-space: nowrap;
  }

  .hero-urgency-day {
    font-size: 1.2em;
    line-height: 1;
  }

  /* ── Scroll cue ── */
  .hero-scroll-cue {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    translate: -50% 0;
    color: rgba(251, 226, 186, 0.85);
    padding: 10px;
  }

  .hero-scroll-cue.visible svg {
    animation: cue-bob 2.2s ease-in-out infinite;
  }

  @keyframes cue-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(7px); }
  }

  /* ── Sound Toggle ── */
  .hero-sound-btn {
    position: absolute;
    bottom: var(--space-xl);
    right: var(--space-xl);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 100px;
    color: white;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hero-sound-btn:hover {
    background: rgba(230, 136, 28, 0.6);
    border-color: rgba(230, 136, 28, 0.8);
    transform: scale(1.05);
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  .sound-icon {
    display: none;
  }

  .sound-icon-off {
    display: block;
  }

  .sound-icon.hidden {
    display: none !important;
  }

  .sound-icon:not(.hidden).sound-icon-on {
    display: block;
  }

  /* ── Scroll Indicator ── */
  .scroll-indicator {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    animation: bounce 2s infinite;
  }

  .scroll-arrow {
    color: rgba(251, 226, 186, 0.6);
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .hero-content {
      padding: var(--space-3xl) var(--space-xl);
      gap: var(--space-lg);
    }

    .hero-content-overlay {
      padding: calc(var(--nav-height) + var(--space-2xl)) var(--space-xl) var(--space-2xl);
    }

    .hero-narrative {
      font-size: var(--text-lg);
    }

    .hero-narrative-secondary {
      font-size: var(--text-sm);
    }

    .hero-cta {
      font-size: var(--text-xl) !important;
      padding: var(--space-md) var(--space-2xl) !important;
    }

    .hero-summary {
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 768px) {
    /* The content column outgrows short viewports; let the hero grow
       instead of clipping (svh avoids the iOS toolbar jump). */
    .hero {
      height: auto;
      min-height: 100vh;
      min-height: 100svh;
      max-height: unset;
    }

    .hero-content-overlay {
      height: auto;
      min-height: 100vh;
      min-height: 100svh;
    }

    .hero-urgency {
      flex-wrap: wrap;
      justify-content: center;
    }

    .hero-narrative {
      font-size: var(--text-base);
      line-height: 1.45;
    }

    .hero-narrative-secondary {
      font-size: var(--text-sm);
      line-height: 1.45;
    }

    .hero-cta {
      font-size: var(--text-base) !important;
      padding: var(--space-sm) var(--space-xl) !important;
    }

    .hero-summary {
      font-size: var(--text-xs);
      line-height: 1.5;
    }

    .hero-receipts {
      gap: var(--space-sm);
    }

    .hero-receipt {
      padding: 7px 10px;
    }

    .hero-receipt-number {
      font-size: var(--text-base);
    }

    .hero-receipt-label {
      font-size: 0.5rem;
      letter-spacing: 0.06em;
    }

    .hero-scroll-cue {
      display: none;
    }

    .hero-content {
      padding: var(--space-lg) var(--space-md);
      gap: var(--space-md);
    }

    .hero-content-overlay {
      padding-top: calc(var(--nav-height) + var(--space-sm));
      padding-bottom: var(--space-xl);
    }

    .hero-badge {
      font-size: 9px;
      padding: 4px 12px;
      letter-spacing: 0.15em;
    }

    .hero-sound-btn {
      bottom: var(--space-md);
      right: var(--space-sm);
      padding: 6px 12px;
      font-size: 9px;
    }

    /* Clear the mobile action bar while it is on screen */
    :global(body.has-action-bar) .hero-sound-btn {
      bottom: calc(var(--space-md) + 104px);
    }

    .hero-video-container.video-watching {
      padding: var(--space-lg);
    }
  }

  /* Phones and portrait tablets: a 16:9 frame cover-filled into a tall box
     shows a narrow slice of it. Aim that slice at Byron's paper card
     (source x 96..646 of 1920) instead of the empty middle. */
  @media (max-width: 767px), (orientation: portrait) and (max-width: 1366px) {
    .hero-video {
      object-position: 9% 50%;
    }
  }

  @media (max-width: 767px) {
    .hero-video-container.video-watching {
      padding: calc(var(--nav-height) + var(--space-sm)) var(--space-sm) calc(var(--space-2xl) + 40px);
    }
  }

  /* Landscape tablet and desktop: the column sits in the left third over
     the paper card, and the scrim is weighted left so the placards,
     receipts and end panel on the right two thirds read. The story starts
     at about 37% of the frame, so the column ends before that. */
  @media (min-width: 768px) and (orientation: landscape) {
    /* Start the frame under the fixed nav so the top placard line is not
       hidden behind it. */
    /* The strip behind the translucent nav matches the nav itself */
    .hero {
      background: var(--cream);
    }

    .hero-video-bg {
      top: var(--nav-height);
      height: auto;
      bottom: 0;
    }

    .hero-video {
      /* Narrower than 16:9: favour the left edge so the story shifts right.
         Wider than 16:9: trim a little from the top and more from the
         bottom, keeping the caption band (source y 700..950) in view. */
      object-position: 30% 30%;
    }

    .hero-video-container.video-watching {
