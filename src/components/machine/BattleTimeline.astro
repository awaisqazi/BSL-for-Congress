---
// The movement's road, 2015 to February 23, 2027: a vertical timeline whose
// progress line draws as you scroll (motion.js [data-bt] handler). Keeps the
// #ballot-fight anchor. The 22,788 signature wall sits inside the congressional
// stop as a memorial, not at the top of the page.
import SignatureWall from '../SignatureWall.astro';

const stages = [
  { date: 'timeline.s1_date', dateText: 'For 23 years', title: 'timeline.s1_title', titleText: 'The machine\'s ward', desc: 'timeline.s1_desc', descText: 'The 25th Ward belongs to Danny Solis and the machine behind him. Zoning, permits, and favors run through one office, and it ends with the alderman disgraced and a federal investigation at City Hall.' },
  { date: 'timeline.s2_date', dateText: 'The organizing years', title: 'timeline.s2_title', titleText: 'Pilsen Alliance', desc: 'timeline.s2_desc', descText: 'The city moves to close 130 public schools. Byron organizes with parents and teachers to keep them open, then leads the Pilsen Alliance against displacement and corruption.' },
  { date: 'timeline.s3_date', dateText: '2015', title: 'timeline.s3_title', titleText: 'The first run', desc: 'timeline.s3_desc', descText: 'Byron runs for alderman against Danny Solis and finishes second. He makes a pledge that outlasts the race: no money from developers or big corporations.' },
  { date: 'timeline.s4_date', dateText: '2019', title: 'timeline.s4_title', titleText: 'The ward comes home', desc: 'timeline.s4_desc', descText: 'A grassroots campaign wins the 25th Ward, the machine\'s oldest prize. Ward Night starts every Tuesday, and the doors of the ward office open to everyone.' },
  { date: 'timeline.s5_date', dateText: 'First term', title: 'timeline.s5_title', titleText: 'Receipts, not promises', desc: 'timeline.s5_desc', descText: '800+ affordable units created or preserved. Zoning opened to residents through the Zoning Advisory Board. $1M+ in state infrastructure for Benito Juarez and ward schools. $500,000+ for violence prevention.' },
  { date: 'timeline.s6_date', dateText: '2023', title: 'timeline.s6_title', titleText: 'They came back with money', desc: 'timeline.s6_desc', descText: 'Crain\'s reports that the business-backed Get Stuff Done PAC drops just under $160,000 into the ward against Byron, part of more than $618,000 spent citywide, with nearly a fifth of it aimed at him (WTTW). The ward sends Byron back.' },
  { date: 'timeline.s7_date', dateText: '2026', title: 'timeline.s7_title', titleText: 'The congressional chapter', desc: 'timeline.s7_desc', descText: 'Byron runs for Congress as an independent after the seat is handed to a former chief of staff. She needs 697 signatures. The law demands 10,816 of him. The movement files 22,788, and in July an electoral board strikes him from the November ballot, 1,222 short. He sues in federal court.' },
  { wall: true },
  { date: 'timeline.s8_date', dateText: 'NOW', title: 'timeline.s8_title', titleText: 'The movement comes home', desc: 'timeline.s8_desc', descText: 'August 18: the movement packs Indígó MRKTŌ in Pilsen to launch the re-election campaign. Byron runs for a third term as Alderman of the 25th Ward, and petition season starts this fall.', now: true, cta: { href: '#petition', key: 'timeline.s8_cta', text: 'Join the Campaign' } },
  { date: 'timeline.s9_date', dateText: 'February 23, 2027', title: 'timeline.s9_title', titleText: 'You decide', desc: 'timeline.s9_desc', descText: 'Not the machine. Not their lawyers. The ward decides who its alderman answers to. You decide.' },
];
---

<section class="battle section-padding" id="ballot-fight">
  <div class="container">
    <span class="section-label animate-in" style="text-align:center;display:block;" data-i18n="timeline.label">The Long Road</span>
    <h2 class="section-title animate-in" style="text-align:center;" data-i18n="timeline.headline">The Road to February 23</h2>

    <ol class="bt-list" data-bt>
      <div class="bt-spine" aria-hidden="true">
        <div class="bt-spine-fill" data-bt-fill></div>
      </div>
      {stages.map((s) => s.wall ? (
        <li class="bt-item bt-item-wall animate-in">
          <div class="battle-wall">
            <SignatureWall />
          </div>
        </li>
      ) : (
        <li class={`bt-item animate-in ${s.now ? 'bt-now' : ''}`}>
          <span class="bt-dot" aria-hidden="true"></span>
          <div class="bt-card">
            <span class="bt-date" data-i18n={s.date}>{s.dateText}</span>
            <h3 class="bt-title" data-i18n={s.title}>{s.titleText}</h3>
            <p class="bt-desc" data-i18n={s.desc}>{s.descText}</p>
            {s.cta && (
              <a
                href={s.cta.href}
                class="btn btn-orange bt-cta"
                target={s.cta.external ? '_blank' : undefined}
                rel={s.cta.external ? 'noopener' : undefined}
                data-i18n={s.cta.key}
              >{s.cta.text}</a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Final CTA band -->
<section class="machine-cta-block">
  <div class="machine-cta-bg">
    <div class="machine-cta-pattern"></div>
  </div>
  <div class="container machine-cta-content">
    <h2 class="machine-cta-headline animate-in" data-i18n="machine.cta_headline">This Ward Is Not For Sale. Let's Keep It That Way.</h2>
    <div class="machine-cta-buttons animate-in">
      <a href="#petition" class="btn btn-orange btn-massive" data-i18n="machine.cta_petition">Join the Campaign</a>
      <a href="https://secure.actblue.com/donate/byron-sigcho-1" class="btn btn-outline" target="_blank" rel="noopener" data-i18n="machine.cta_donate">Fund the Campaign</a>
    </div>
  </div>
</section>

<style>
  .battle {
    background: var(--cream);
  }

  .battle-wall {
    margin: 0 auto var(--space-md);
    max-width: 900px;
  }

  /* The 22,788 wall rides inside the road as a memorial, full width */
  .bt-item-wall {
    padding-bottom: var(--space-2xl);
  }

  .bt-list {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: var(--space-xl) 0;
    max-width: 980px;
  }

  .bt-spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 15px;
    width: 4px;
    background: rgba(3, 109, 153, 0.15);
    border-radius: 100px;
    overflow: hidden;
  }

  .bt-spine-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--orange-light), var(--orange), var(--orange-dark));
    transform: scaleY(0);
    transform-origin: top;
  }

  .bt-item {
    position: relative;
    padding: 0 0 var(--space-2xl) 56px;
  }

  .bt-item:last-child {
    padding-bottom: 0;
  }

  .bt-dot {
    position: absolute;
    left: 8px;
    top: 6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--cream);
    border: 3px solid rgba(3, 109, 153, 0.35);
    transition: background var(--duration-normal) var(--ease-default), border-color var(--duration-normal) var(--ease-default), box-shadow var(--duration-normal) var(--ease-default);
  }

  .bt-item.reached .bt-dot {
    background: var(--orange);
    border-color: var(--orange-dark);
    box-shadow: 0 0 0 5px rgba(230, 136, 28, 0.2);
  }

  .bt-now .bt-dot::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(230, 136, 28, 0.5);
    animation: bt-pulse 2s ease-out infinite;
  }

  @keyframes bt-pulse {
    0% { scale: 0.7; opacity: 1; }
    100% { scale: 1.5; opacity: 0; }
  }

  .bt-card {
    background: var(--white);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
    border-left: 4px solid rgba(3, 109, 153, 0.2);
    transition: border-color var(--duration-normal) var(--ease-default);
  }

  .bt-item.reached .bt-card {
    border-left-color: var(--orange);
  }

  .bt-now .bt-card {
    border: 2px solid var(--orange);
    border-left-width: 4px;
    box-shadow: var(--shadow-md);
  }

  .bt-date {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--orange-dark);
    margin-bottom: var(--space-xs);
  }

  .bt-now .bt-date {
    color: var(--white);
    background: var(--orange);
    padding: 2px 10px;
    border-radius: 3px;
    rotate: -1.5deg;
  }

  .bt-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--blue-deeper);
    margin-bottom: var(--space-sm);
  }

  .bt-desc {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--gray-700);
  }

  .bt-cta {
    margin-top: var(--space-md);
  }

  /* Desktop: center spine, alternating cards */
  @media (min-width: 900px) {
    .bt-spine {
      left: 50%;
      translate: -50% 0;
    }

    .bt-item {
      width: calc(50% - 44px);
      padding-left: 0;
    }

    .bt-item .bt-dot {
      left: auto;
      right: -57px;
    }

    .bt-item:nth-child(odd) {
      margin-left: auto;
      padding-left: 0;
    }

    .bt-item:nth-child(odd) .bt-dot {
      right: auto;
      left: -57px;
    }

    .bt-item-wall,
    .bt-item-wall:nth-child(odd) {
      width: 100%;
      margin-left: 0;
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-spine-fill { transform: scaleY(1); }
    .bt-now .bt-dot::after { animation: none; opacity: 0; }
  }

  /* Final CTA band (carried over from the retired BallotFight) */
  .machine-cta-block {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: hidden;
  }

  .machine-cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--blue) 0%, var(--blue-deeper) 100%);
    z-index: 0;
  }

  .machine-cta-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.1) 0%, transparent 50%);
  }

  .machine-cta-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
  }

  .machine-cta-headline {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--cream);
    text-transform: uppercase;
    max-width: 700px;
  }

  .machine-cta-buttons {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .machine-cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .machine-cta-buttons .btn {
      width: 100%;
    }
  }
</style>
