---
// The Ballot Battle: a road-style vertical timeline whose progress line
// draws as you scroll (motion.js [data-bt] handler). Replaces BallotFight;
// keeps the #ballot-fight anchor. The canvas signature wall sits on top.
import SignatureWall from '../SignatureWall.astro';

const stages = [
  { date: 'timeline.s1_date', dateText: 'March 17', title: 'timeline.s1_title', titleText: 'Their coronation', desc: 'timeline.s1_desc', descText: 'IL-04 voters got exactly one choice on the primary ballot. The machine chose on our behalf.' },
  { date: 'timeline.s2_date', dateText: 'Spring', title: 'timeline.s2_title', titleText: 'The promise', desc: 'timeline.s2_desc', descText: 'Byron announces in Pilsen. A reporter asks if 10,816 signatures is even possible. The room raises its hands and promises 20,000.' },
  { date: 'timeline.s3_date', dateText: 'Early June', title: 'timeline.s3_title', titleText: 'The promise kept', desc: 'timeline.s3_desc', descText: 'The movement files 22,788 valid signatures with the Illinois State Board of Elections, more than double the law’s demand.' },
  { date: 'timeline.s4_date', dateText: 'June 9', title: 'timeline.s4_title', titleText: 'The objection', desc: 'timeline.s4_desc', descText: 'A machine-backed objector files a challenge to throw out your signatures and erase your choice.' },
  { date: 'timeline.s5_date', dateText: 'NOW', title: 'timeline.s5_title', titleText: 'The defense', desc: 'timeline.s5_desc', descText: 'Records exams and hearings at the State Board of Elections. The movement defends every line while machine lawyers try to strike them.', now: true, cta: { href: '#petition', key: 'timeline.s5_cta', text: 'Join the Defense' } },
  { date: 'timeline.s6_date', dateText: 'By early August', title: 'timeline.s6_title', titleText: 'The ruling', desc: 'timeline.s6_desc', descText: 'The Board rules on the challenge. This is the day we keep your choice alive.', cta: { href: 'https://secure.actblue.com/donate/byronfor04web/', key: 'timeline.s6_cta', text: 'Fund the Legal Defense', external: true } },
  { date: 'timeline.s7_date', dateText: 'November 3', title: 'timeline.s7_title', titleText: 'You decide', desc: 'timeline.s7_desc', descText: 'Not the machine. Not the lawyers. You.' },
];
---

<section class="battle section-padding" id="ballot-fight">
  <div class="container">
    <span class="section-label animate-in" style="text-align:center;display:block;" data-i18n="timeline.label">The Ballot Battle</span>
    <h2 class="section-title animate-in" style="text-align:center;" data-i18n="timeline.headline">The Road to November</h2>

    <div class="battle-wall animate-in">
      <SignatureWall />
    </div>

    <ol class="bt-list" data-bt>
      <div class="bt-spine" aria-hidden="true">
        <div class="bt-spine-fill" data-bt-fill></div>
      </div>
      {stages.map((s) => (
        <li class={`bt-item animate-in ${s.now ? 'bt-now' : ''}`}>
          <span class="bt-dot" aria-hidden="true"></span>
          <div class="bt-card">
            <span class="bt-date" data-i18n={s.date}>{s.dateText}</span>
            <h3 class="bt-title" data-i18n={s.title}>{s.titleText}</h3>
            <p class="bt-desc" data-i18n={s.desc}>{s.descText}</p>
            {s.cta && (
              <a
                href={s.cta.href}
                class="btn btn-orange bt-cta"
                target={s.cta.external ? '_blank' : undefined}
                rel={s.cta.external ? 'noopener' : undefined}
                data-i18n={s.cta.key}
              >{s.cta.text}</a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Final CTA band -->
<section class="machine-cta-block">
  <div class="machine-cta-bg">
    <div class="machine-cta-pattern"></div>
  </div>
  <div class="container machine-cta-content">
    <h2 class="machine-cta-headline animate-in" data-i18n="machine.cta_headline">They're Trying to Erase Your Choice. Fight Back.</h2>
    <div class="machine-cta-buttons animate-in">
      <a href="#petition" class="btn btn-orange btn-massive" data-i18n="machine.cta_petition">Join the Fight</a>
      <a href="https://secure.actblue.com/donate/byronfor04web/" class="btn btn-outline" target="_blank" rel="noopener" data-i18n="machine.cta_donate">Fund the Legal Defense</a>
    </div>
  </div>
</section>

<style>
  .battle {
    background: var(--cream);
  }

  .battle-wall {
    margin: var(--space-2xl) auto var(--space-3xl);
    max-width: 900px;
  }

  .bt-list {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: var(--space-xl) 0;
    max-width: 980px;
  }

  .bt-spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 15px;
    width: 4px;
    background: rgba(3, 109, 153, 0.15);
    border-radius: 100px;
    overflow: hidden;
  }

  .bt-spine-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--orange-light), var(--orange), var(--orange-dark));
    transform: scaleY(0);
    transform-origin: top;
  }

  .bt-item {
    position: relative;
    padding: 0 0 var(--space-2xl) 56px;
  }

  .bt-item:last-child {
    padding-bottom: 0;
  }

  .bt-dot {
    position: absolute;
    left: 8px;
    top: 6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--cream);
    border: 3px solid rgba(3, 109, 153, 0.35);
    transition: background var(--duration-normal) var(--ease-default), border-color var(--duration-normal) var(--ease-default), box-shadow var(--duration-normal) var(--ease-default);
  }

  .bt-item.reached .bt-dot {
    background: var(--orange);
    border-color: var(--orange-dark);
    box-shadow: 0 0 0 5px rgba(230, 136, 28, 0.2);
  }

  .bt-now .bt-dot::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid rgba(230, 136, 28, 0.5);
    animation: bt-pulse 2s ease-out infinite;
  }

  @keyframes bt-pulse {
    0% { scale: 0.7; opacity: 1; }
    100% { scale: 1.5; opacity: 0; }
  }

  .bt-card {
    background: var(--white);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
    border-left: 4px solid rgba(3, 109, 153, 0.2);
    transition: border-color var(--duration-normal) var(--ease-default);
  }

  .bt-item.reached .bt-card {
    border-left-color: var(--orange);
  }

  .bt-now .bt-card {
    border: 2px solid var(--orange);
    border-left-width: 4px;
    box-shadow: var(--shadow-md);
  }

  .bt-date {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--orange-dark);
    margin-bottom: var(--space-xs);
  }

  .bt-now .bt-date {
    color: var(--white);
    background: var(--orange);
    padding: 2px 10px;
    border-radius: 3px;
    rotate: -1.5deg;
  }

  .bt-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--blue-deeper);
    margin-bottom: var(--space-sm);
  }

  .bt-desc {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--gray-700);
  }

  .bt-cta {
    margin-top: var(--space-md);
  }

  /* Desktop: center spine, alternating cards */
  @media (min-width: 900px) {
    .bt-spine {
      left: 50%;
      translate: -50% 0;
    }

    .bt-item {
      width: calc(50% - 44px);
      padding-left: 0;
    }

    .bt-item .bt-dot {
      left: auto;
      right: -57px;
    }

    .bt-item:nth-child(odd) {
      margin-left: auto;
      padding-left: 0;
    }

    .bt-item:nth-child(odd) .bt-dot {
      right: auto;
      left: -57px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-spine-fill { transform: scaleY(1); }
    .bt-now .bt-dot::after { animation: none; opacity: 0; }
  }

  /* Final CTA band (carried over from the retired BallotFight) */
  .machine-cta-block {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: hidden;
  }

  .machine-cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--blue) 0%, var(--blue-deeper) 100%);
    z-index: 0;
  }

  .machine-cta-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.1) 0%, transparent 50%);
  }

  .machine-cta-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
  }

  .machine-cta-headline {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--cream);
    text-transform: uppercase;
    max-width: 700px;
  }

  .machine-cta-buttons {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .machine-cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .machine-cta-buttons .btn {
      width: 100%;
    }
  }
</style>
