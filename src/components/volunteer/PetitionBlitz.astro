---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="petition-blitz" id="petition-blitz">
  <div class="blitz-bg"></div>

  <div class="container blitz-content">
    <div class="blitz-alert animate-in">
      <span class="blitz-alert-icon">✊</span>
      <span class="blitz-alert-text" data-i18n="volunteer.blitz_alert">THE WARD CAMPAIGN IS LIVE</span>
    </div>

    <h2 class="blitz-headline animate-in" data-i18n="volunteer.blitz_headline">The Ward Answers on February 23</h2>

    <p class="blitz-text animate-in" data-i18n="volunteer.blitz_p1">
      This summer, machine lawyers kept his name off a congressional ballot. The 25th Ward tells a different story: we knock every door and answer at the ballot box on February 23, 2027.
    </p>

    <a class="blitz-link animate-in" href={`${base}/movement#ballot-fight`}>
      <span data-i18n="volunteer.blitz_link">Read what happened this summer</span>
      <span aria-hidden="true">→</span>
    </a>

    <div class="blitz-status animate-in">
      <span class="blitz-status-chip">
        <span aria-hidden="true">🏠</span>
        <span data-i18n="volunteer.status_wardnight">Ward Night Every Tuesday</span>
      </span>
      <span class="blitz-status-chip">
        <span aria-hidden="true">✊</span>
        <span data-i18n="volunteer.status_launched">Launched August 18</span>
      </span>
      <span class="blitz-status-chip" data-days-until="2027-02-23">
        <span aria-hidden="true">🗳️</span>
        <span data-i18n="volunteer.status_electionday">Election Day February 23, 2027</span>
      </span>
    </div>

    <div class="blitz-cta animate-in">
      <a href="#petition" class="btn btn-cream btn-massive" data-i18n="volunteer.blitz_download">
        ✊ Join the Ward Campaign
      </a>
    </div>
  </div>
</section>

<style>
  .petition-blitz {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: hidden;
  }

  .blitz-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--orange) 0%, var(--orange-dark) 100%);
    z-index: 0;
  }

  .blitz-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  /* Alert Banner */
  .blitz-alert {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 8px 20px;
    border-radius: 100px;
    margin-bottom: var(--space-xl);
    backdrop-filter: blur(4px);
  }

  .blitz-alert-icon {
    font-size: 1.2rem;
  }

  .blitz-alert-text {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #ffffff;
  }

  .blitz-headline {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 900;
    line-height: 1;
    color: #ffffff;
    text-transform: uppercase;
    margin-bottom: var(--space-xl);
  }

  .blitz-text {
    font-size: var(--text-base);
    line-height: 1.8;
    color: #ffffff;
    margin-bottom: var(--space-md);
  }

  .blitz-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-bottom: var(--space-2xl);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .blitz-link:hover {
    color: var(--gold-soft);
  }

  .blitz-status {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
  }

  .blitz-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.2);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    border-radius: 100px;
  }

  /* CTA */
  .blitz-cta {
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .blitz-headline {
      font-size: var(--text-3xl);
    }
  }
</style>
