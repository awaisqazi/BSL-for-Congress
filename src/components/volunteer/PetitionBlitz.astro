---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!-- id is "sign-petition", not "petition": PetitionModal hijacks every link whose
     href contains "#petition" and opens the modal instead of scrolling here. -->
<section class="petition-blitz" id="sign-petition">
  <div class="blitz-bg"></div>

  <div class="container blitz-content">
    <div class="blitz-alert animate-in">
      <span class="blitz-alert-icon">✊</span>
      <span class="blitz-alert-text" data-i18n="volunteer.blitz_alert">THE WARD CAMPAIGN IS LIVE</span>
    </div>

    <h2 class="blitz-headline animate-in" data-i18n="volunteer.blitz_headline">The Ward Answers on February 23</h2>

    <p class="blitz-text animate-in" data-i18n="volunteer.blitz_p1">
      This summer, machine lawyers kept his name off a congressional ballot. The 25th Ward tells a different story: we knock every door and answer at the ballot box on February 23, 2027.
    </p>

    <a class="blitz-link animate-in" href={`${base}/movement#ballot-fight`}>
      <span data-i18n="volunteer.blitz_link">Read what happened this summer</span>
      <span aria-hidden="true">→</span>
    </a>

    <!-- Petition season: comes off the page the morning after filing closes
         (data-expires is handled by the NextUp/RoadCTA scripts). -->
    <div class="blitz-petition animate-in anim-pin" style="--tilt: -0.6deg" data-expires="2026-10-26">
      <span class="blitz-petition-label" data-i18n="volunteer.petition_label">Sign the Petition</span>
      <h3 class="blitz-petition-headline" data-i18n="volunteer.petition_headline">Put Byron on the February 23 Ballot</h3>
      <p class="blitz-petition-text" data-i18n="volunteer.petition_what">This is the nominating petition that puts Byron's name on the February 23, 2027 ballot. Signatures are collected through the filing window, October 19 to 26, 2026.</p>
      <p class="blitz-petition-text" data-i18n="volunteer.petition_who">If you are registered to vote in the 25th Ward, you can sign once. One signature per neighbor, and every one counts.</p>
      <p class="blitz-petition-text" data-i18n="volunteer.petition_where">Sign it at Ward Night any Tuesday, on a Sunday canvass, or check the petition box on the form and the campaign will bring it to you.</p>
      <a href="#signup" class="btn btn-orange blitz-petition-cta" data-i18n="volunteer.petition_cta">Bring the Petition to Me</a>
    </div>

    <div class="blitz-status animate-in">
      <span class="blitz-status-chip">
        <span aria-hidden="true">🏠</span>
        <span data-i18n="volunteer.status_wardnight">Ward Night Every Tuesday</span>
      </span>
      <span class="blitz-status-chip">
        <span aria-hidden="true">✊</span>
        <span data-i18n="volunteer.status_launched">Launched August 18</span>
      </span>
      <!-- No data-days-until on the chip itself: the counter script replaces an
           element's whole textContent, which wiped the icon and label and left a
           bare number. The countdown lives in the ledger right below. -->
      <span class="blitz-status-chip">
        <span aria-hidden="true">🗳️</span>
        <span data-i18n="volunteer.status_electionday">Election Day February 23, 2027</span>
      </span>
    </div>

    <div class="blitz-cta animate-in">
      <a href="#signup" class="btn btn-cream btn-massive" data-i18n="volunteer.blitz_download">
        ✊ Knock Doors With Us
      </a>
    </div>
  </div>
</section>

<style>
  .petition-blitz {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: hidden;
  }

  .blitz-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--orange) 0%, var(--orange-dark) 100%);
    z-index: 0;
  }

  .blitz-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  /* Alert Banner */
  .blitz-alert {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 8px 20px;
    border-radius: 100px;
    margin-bottom: var(--space-xl);
    backdrop-filter: blur(4px);
  }

  .blitz-alert-icon {
    font-size: 1.2rem;
  }

  .blitz-alert-text {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #ffffff;
  }

  .blitz-headline {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 900;
    line-height: 1;
    color: #ffffff;
    text-transform: uppercase;
    margin-bottom: var(--space-xl);
  }

  .blitz-text {
    font-size: var(--text-base);
    line-height: 1.8;
    color: #ffffff;
    margin-bottom: var(--space-md);
  }

  .blitz-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-bottom: var(--space-2xl);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .blitz-link:hover {
    color: var(--gold-soft);
  }

  /* Petition ask: a cream flyer pinned on the orange band */
  .blitz-petition {
    background: var(--cream);
    color: var(--black);
    border-radius: 6px;
    padding: var(--space-xl) var(--space-xl) var(--space-lg);
    margin: 0 auto var(--space-2xl);
    max-width: 620px;
    text-align: left;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
  }

  .blitz-petition-label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--orange-dark);
    margin-bottom: var(--space-xs, 4px);
  }

  .blitz-petition-headline {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .blitz-petition-text {
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-sm);
  }

  .blitz-petition-cta {
    margin-top: var(--space-sm);
  }

  .blitz-status {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
  }

  .blitz-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.2);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    border-radius: 100px;
  }

  /* CTA */
  .blitz-cta {
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .blitz-headline {
      font-size: var(--text-3xl);
    }

    .blitz-petition {
      padding: var(--space-lg);
    }

    .blitz-petition-headline {
      font-size: var(--text-xl);
    }
  }
</style>
