---
---

<section class="signup-section section-padding" id="signup">
  <div class="container">
    <div class="signup-grid">
      <div class="signup-text">
        <span class="section-label animate-in" data-i18n="volunteer.signup_label">Sign Up</span>
        <h2 class="section-title animate-in" data-i18n="volunteer.signup_headline">Sign Up to Volunteer</h2>
        <p class="signup-desc animate-in" data-i18n="volunteer.signup_desc">
          Tell us your block and how you want to help. The campaign follows up to place you. One hour or one hundred, there is a post for you.
        </p>

        <ol class="signup-steps animate-in">
          <li class="signup-step">
            <span class="signup-step-num" aria-hidden="true">1</span>
            <span data-i18n="volunteer.next_step1">You sign up. The campaign follows up to place you.</span>
          </li>
          <li class="signup-step">
            <span class="signup-step-num" aria-hidden="true">2</span>
            <span data-i18n="volunteer.next_step2">You get a post: your block, your phone, your campus, your craft.</span>
          </li>
          <li class="signup-step">
            <span class="signup-step-num" aria-hidden="true">3</span>
            <span data-i18n="volunteer.next_step3">We knock doors together and win on February 23, 2027.</span>
          </li>
        </ol>
        <p class="signup-solidarity animate-in" data-i18n="volunteer.signoff">Solidarity!</p>
      </div>

      <form class="signup-form animate-in" id="volunteer-form" data-action-bar-hide action="https://docs.google.com/forms/d/e/1FAIpQLSeUKnQVp4auTqHdFZeDrGlAOYAjmOO0sE19Xm11Pee2ayuuWQ/formResponse" method="POST" target="hidden_iframe_volunteer">
        <div class="form-row">
          <div class="form-group">
            <label for="first-name" data-i18n="volunteer.label_first">First Name *</label>
            <input type="text" id="first-name" name="entry.661274230" required />
          </div>
          <div class="form-group">
            <label for="last-name" data-i18n="volunteer.label_last">Last Name *</label>
            <input type="text" id="last-name" name="entry.449873967" required />
          </div>
        </div>

        <div class="form-group">
          <label for="email" data-i18n="volunteer.label_email">Email *</label>
          <input type="email" id="email" name="entry.378191335" required />
        </div>

        <div class="form-row form-row-3">
          <div class="form-group">
            <label for="phone" data-i18n="volunteer.label_phone">Mobile Phone *</label>
            <input type="tel" id="phone" name="entry.763325091" required />
          </div>
          <div class="form-group">
            <label for="city" data-i18n="volunteer.label_city">City *</label>
            <input type="text" id="city" name="entry.113002180" required />
          </div>
          <div class="form-group">
            <label for="zip" data-i18n="volunteer.label_zip">ZIP Code *</label>
            <input type="text" id="zip" name="entry.1587719447" pattern="[0-9]{5}" maxlength="5" required />
          </div>
        </div>

        <fieldset class="form-checkboxes">
          <legend data-i18n="volunteer.help_legend">How would you like to help?</legend>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Collect Petition Signatures" />
            <span class="checkbox-text" data-i18n="volunteer.check_petition">Spread the Word (Share the Campaign Online & With Neighbors)</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Knock on Doors" />
            <span class="checkbox-text" data-i18n="volunteer.check_canvass">Knock on Doors</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Phone/Text Banking" />
            <span class="checkbox-text" data-i18n="volunteer.check_phone">Phone/Text Banking</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Host a Meet & Greet" />
            <span class="checkbox-text" data-i18n="volunteer.check_host">Host a Meet & Greet</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Bilingual Outreach (I speak Spanish / Yo hablo español)" />
            <span class="checkbox-text" data-i18n="volunteer.check_bilingual">Bilingual Outreach (I speak Spanish / Yo hablo español)</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Post on Social Media" />
            <span class="checkbox-text" data-i18n="volunteer.check_social_media">Post on Social Media</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Precinct Captain / Volunteer" />
            <span class="checkbox-text" data-i18n="volunteer.check_precinct_captain">Precinct Captain / Volunteer</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="High School Ambassador" />
            <span class="checkbox-text" data-i18n="volunteer.check_hs_ambassador">High School Ambassador</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="College Campus Captain / Volunteer" />
            <span class="checkbox-text" data-i18n="volunteer.check_college_captain">College Campus Captain / Volunteer</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Help Create Marketing Collateral (Graphic Design)" />
            <span class="checkbox-text" data-i18n="volunteer.check_marketing">Help Create Marketing Collateral (Graphic Design)</span>
          </label>

          <label class="checkbox-label">
            <input type="checkbox" name="entry.1014527396" value="Help Create Campaign Videos (Videography / Video Editing)" />
            <span class="checkbox-text" data-i18n="volunteer.check_videos">Help Create Campaign Videos (Videography / Video Editing)</span>
          </label>
        </fieldset>

        <p class="form-compliance" data-i18n="volunteer.compliance">
          By submitting, you agree to receive periodic campaign updates via SMS. Message and data rates may apply. Text STOP to unsubscribe.
        </p>

        <button type="submit" class="btn btn-orange btn-massive form-submit" data-i18n="volunteer.submit">
          Count Me In
        </button>
        
        <!-- What happens next. Links sit outside the i18n spans so a language swap keeps them. -->
        <div class="volunteer-success" id="volunteer-success">
          <p class="volunteer-success-head" data-i18n="volunteer.success_msg">You're in. Here is what happens next.</p>
          <ol class="signup-steps volunteer-success-steps">
            <li class="signup-step">
              <span class="signup-step-num" aria-hidden="true">1</span>
              <a href="https://25thward.org/" target="_blank" rel="noopener" data-i18n="volunteer.success_wardnight">Ward Night is every Tuesday at the ward office. Come by this week.</a>
            </li>
            <li class="signup-step">
              <span class="signup-step-num" aria-hidden="true">2</span>
              <a href="https://canvass.chicagodsa.org" target="_blank" rel="noopener" data-i18n="volunteer.success_canvass">Canvasses run on Sundays. Pick your first shift on the canvass map.</a>
            </li>
            <li class="signup-step">
              <span class="signup-step-num" aria-hidden="true">3</span>
              <span data-i18n="volunteer.success_followup">The campaign will follow up to place you at your post.</span>
            </li>
          </ol>
          <button type="button" class="btn btn-outline volunteer-share" id="volunteer-share">
            <span data-i18n="volunteer.share_btn">Copy the Link, Send It to a Neighbor</span>
            <span class="share-check" aria-hidden="true">✓</span>
          </button>
        </div>
        <iframe name="hidden_iframe_volunteer" id="hidden_iframe_volunteer" style="display:none;"></iframe>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('volunteer-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('volunteer-success');

  if (form) {
    form.addEventListener('submit', function () {
      setTimeout(function () {
        form.reset();
        // Swap the fields for the next steps (Ward Night, the canvass map,
        // the follow-up) and leave them up. No timer; they read at their pace.
        form.classList.add('is-submitted');
        if (successMsg) {
          successMsg.classList.add('visible');
          successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }, 500);
    });
  }

  const shareBtn = document.getElementById('volunteer-share');
  shareBtn?.addEventListener('click', async () => {
    const url = location.origin + (document.body.dataset.base || '') + '/';
    try {
      await navigator.clipboard.writeText(url);
      shareBtn.classList.add('copied');
      setTimeout(() => shareBtn.classList.remove('copied'), 2000);
    } catch {
      // Clipboard unavailable: select-free fallback, show the URL via prompt
      window.prompt('Copy this link:', url);
    }
  });
</script>

<style>
  .signup-section {
    background: var(--cream);
    scroll-margin-top: var(--nav-height); /* #signup deep links land below the fixed navbar */
  }

  .signup-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  .signup-desc {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--gray-700);
    margin-top: var(--space-md);
  }

  .signup-text {
    position: sticky;
    top: calc(var(--nav-height, 80px) + var(--space-xl));
  }

  /* Form Styles */
  .signup-form {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    box-shadow: var(--shadow-md);
    border: 2px solid rgba(5, 173, 237, 0.1);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .form-row-3 {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .form-group {
    margin-bottom: var(--space-lg);
  }

  .form-group label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--blue);
    margin-bottom: 6px;
  }

  .form-group input {
    width: 100%;
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: var(--text-base);
    border: 2px solid rgba(5, 173, 237, 0.2);
    border-radius: var(--radius-md);
    background: var(--cream-light);
    color: var(--black);
    transition: border-color var(--duration-fast) var(--ease-default), box-shadow var(--duration-fast) var(--ease-default);
    box-sizing: border-box;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(5, 173, 237, 0.15);
  }

  /* Checkboxes */
  .form-checkboxes {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-lg) 0;
  }

  .form-checkboxes legend {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--blue);
    margin-bottom: var(--space-md);
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 10px 0;
    cursor: pointer;
    border-bottom: 1px solid rgba(5, 173, 237, 0.06);
    transition: background var(--duration-fast) var(--ease-default);
  }

  .checkbox-label:last-child {
    border-bottom: none;
  }

  .checkbox-label:hover {
    background: rgba(5, 173, 237, 0.02);
  }

  .checkbox-label input[type="checkbox"] {
    width: 20px;
    height: 20px;
    accent-color: var(--orange);
    cursor: pointer;
    flex-shrink: 0;
  }

  .checkbox-text {
    font-size: var(--text-sm);
    color: var(--gray-700);
    line-height: 1.4;
  }

  /* Compliance */
  .form-compliance {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--gray-500);
    margin-bottom: var(--space-lg);
  }

  /* Submit */
  .form-submit {
    width: 100%;
    font-size: var(--text-lg) !important;
    padding: 18px 32px !important;
    cursor: pointer;
    border: none;
  }

  /* Success Message */
  .volunteer-success {
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--blue);
    margin-top: 0;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.4s ease, max-height 0.4s ease, margin-top 0.4s ease;
  }

  .volunteer-success.visible {
    opacity: 1;
    max-height: 640px;
    margin-top: var(--space-md);
  }

  /* After submit only the next steps stay on the clipboard */
  .signup-form.is-submitted > :not(.volunteer-success) {
    display: none;
  }

  .volunteer-success-head {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--blue-deeper);
    margin-bottom: var(--space-sm);
  }

  .volunteer-success-steps {
    text-align: left;
    margin: var(--space-md) 0 var(--space-lg);
  }

  .volunteer-success-steps a {
    color: var(--blue-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .volunteer-success-steps a:hover {
    color: var(--orange-dark);
  }

  .volunteer-share {
    position: relative;
  }

  .volunteer-share .share-check {
    display: none;
    color: #1b7a3d;
    font-weight: 900;
    margin-left: 6px;
  }

  .volunteer-share.copied .share-check {
    display: inline;
  }

  /* What happens next */
  .signup-steps {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .signup-step {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--gray-700);
  }

  .signup-step-num {
    flex: none;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 900;
    color: var(--white);
    background: var(--orange);
    border-radius: 50%;
    rotate: -4deg;
  }

  .signup-solidarity {
    margin-top: var(--space-lg);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--orange-dark);
    rotate: -1.5deg;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .signup-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .signup-text {
      position: static;
    }

    .signup-form {
      padding: var(--space-2xl) var(--space-xl);
    }

    .form-row-3 {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .signup-form {
      padding: var(--space-xl);
    }

    .form-row,
    .form-row-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
