---
// The donate ask on the volunteer page, after the form and the roles, never
// before them. Moved out of SignupForm.astro so the form can sit higher.
---

<section class="volunteer-cta-block">
  <div class="volunteer-cta-bg">
    <div class="volunteer-cta-pattern"></div>
  </div>
  <div class="container volunteer-cta-content">
    <h2 class="volunteer-cta-headline animate-in" data-i18n="volunteer.cta_headline">Can't Volunteer Today? Fund the Campaign.</h2>
    <p class="volunteer-cta-text animate-in" data-i18n="volunteer.cta_text">
      This campaign takes zero dollars from developers or corporate PACs. Every dollar you give funds door-knocking, campaign materials, and getting out the vote for February 23, 2027, run entirely by working people like you.
    </p>
    <p class="volunteer-cta-goal animate-in" data-i18n="volunteer.cta_goal">
      Join the grassroots donors who keep this movement in full swing.
    </p>
    <div class="volunteer-cta-buttons animate-in">
      <a href="https://secure.actblue.com/donate/byron-sigcho-1" class="btn btn-orange btn-massive" target="_blank" rel="noopener" data-i18n="volunteer.cta_donate">Chip in $27</a>
    </div>
  </div>
</section>

<style>
  .volunteer-cta-block {
    position: relative;
    padding: var(--space-4xl) 0;
    overflow: hidden;
  }

  .volunteer-cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--blue) 0%, var(--blue-deeper) 100%);
    z-index: 0;
  }

  .volunteer-cta-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background-image: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.1) 0%, transparent 50%);
  }

  .volunteer-cta-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }

  .volunteer-cta-headline {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--cream);
    text-transform: uppercase;
    max-width: 700px;
  }

  .volunteer-cta-text {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: #ffffff;
    max-width: 650px;
  }

  .volunteer-cta-goal {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--gold-soft);
    max-width: 650px;
  }

  @media (max-width: 768px) {
    .volunteer-cta-headline {
      font-size: var(--text-2xl);
    }
  }
</style>
