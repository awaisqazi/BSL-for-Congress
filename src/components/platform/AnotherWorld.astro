---
// Thin bridge band between the platform hero and the policy wall.
---

<section class="another-world">
  <div class="container another-world-content">
    <p class="another-world-quote animate-in" data-i18n="issues.another_world">Another world is not only possible. It is necessary.</p>
    <p class="another-world-sub animate-in" data-i18n="issues.another_world_sub">In the 25th Ward, we are already building it.</p>
  </div>
</section>

<style>
  .another-world {
    background: linear-gradient(135deg, var(--blue) 0%, var(--blue-deeper) 100%);
    padding: var(--space-2xl) 0;
  }

  .another-world-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .another-world-quote {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 900;
    line-height: 1.25;
    color: var(--cream);
    margin: 0;
  }

  .another-world-sub {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--gold-soft);
    margin: 0;
  }
</style>
