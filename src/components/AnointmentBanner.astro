---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="anointment" id="anointment">
  <div class="anointment-bg">
    <div class="anointment-pattern"></div>
  </div>
  
  <div class="container anointment-content">
    <div class="anointment-inner">
      <span class="anointment-label animate-in" data-i18n="anointment.label">This Summer</span>

      <h2 class="anointment-headline animate-in" data-i18n="anointment.headline">
        The Ward Is a Different Story
      </h2>

      <p class="anointment-beat animate-in" data-i18n="anointment.b1">
        Byron ran for Congress as an independent this year. Neighbors filed more than double the signatures the law demanded of him, the machine's lawyers challenged them, and an electoral board struck his name from the November ballot. He is contesting that rule in federal court, and he is home, running for the ward he has served since 2019.
      </p>

      <p class="anointment-kicker animate-in" data-i18n="anointment.kicker">
        They can object to a petition. They cannot object to a neighbor's ballot.
      </p>

      <div class="anointment-actions animate-in">
      <a href={`${base}/movement`} class="btn btn-orange anointment-cta" data-i18n="anointment.cta">
        Read the Full Story
      </a>
      <a class="anointment-press" href="https://blockclubchicago.org/2026/07/21/election-board-kicks-2-latino-independents-off-ballot-for-chuy-garcias-congressional-seat/" target="_blank" rel="noopener noreferrer" data-i18n="anointment.press">
        The receipt: Block Club Chicago, July 21, 2026
      </a>
      </div>
    </div>

  </div>
</section>

<style>
  .anointment {
    position: relative;
    overflow: hidden;
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  .anointment-bg {
    position: absolute;
    inset: 0;
    background: var(--blue);
    z-index: 0;
  }

  .anointment-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    background-image: 
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 20px,
        rgba(255,255,255,0.1) 20px,
        rgba(255,255,255,0.1) 21px
      );
  }

  .anointment-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .anointment-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .anointment-label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--gold-soft);
  }

  .anointment-headline {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 900;
    line-height: 1.05;
    color: var(--cream);
    text-transform: uppercase;
    margin: 0 0 var(--space-xs);
  }

  .anointment-beat {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: #ffffff;
    max-width: 62ch;
  }

  .anointment-kicker {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 900;
    line-height: 1.3;
    color: var(--gold-soft);
    margin: 0;
  }

  .anointment-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .anointment-cta {
    padding: 0.7rem 1.4rem;
    font-size: var(--text-sm);
  }

  .anointment-press {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cream) !important;
    border: 2px dashed rgba(251, 226, 186, 0.6);
    border-radius: 3px;
    padding: 4px 10px;
    rotate: -1deg;
    text-decoration: none;
  }

  .anointment-press:hover {
    color: var(--gold-soft) !important;
    border-color: var(--gold-soft);
  }

  /* Diagonal edge at top */
  .anointment::before {
    content: '';
    position: absolute;
    top: -30px;
    left: 0;
    right: 0;
    height: 60px;
    background: var(--cream-light);
    transform: skewY(-1.5deg);
    z-index: 1;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .anointment {
      padding: var(--space-3xl) 0 var(--space-2xl);
    }

    .anointment-content {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

  }

  @media (max-width: 768px) {
    .anointment-content {
      grid-template-columns: 1fr;
    }


    .anointment-headline {
      font-size: var(--text-xl);
    }
  }
</style>
