---
// "Shift Map" on /volunteer (#map), first in Show Up, above the calendar
// (the home Show Up block links here with "Find a shift near you"): every upcoming dated
// shift that has a geocoded address (events.json "geo", filled by
// ops/geocode-events.mjs), one pin per address. "Show distances from me" (above
// the map) and the locate control (on the map, under the zoom buttons) do the
// same thing: ask the browser for the visitor's location, work out
// straight-line miles right there, drop a "You are here" dot, and move the view
// to fit the visitor plus every pin (unless the visitor is more than FAR_MI from
// the nearest shift: then the view stays on the shifts and the status line says
// how far). The location is never sent to us or stored. Moving the view does
// mean the visitor's browser fetches OpenStreetMap tiles for their own area,
// so the tile server can infer roughly where they are; the privacy line under
// the button says so. The "all shifts" control fits back to the pins.
// Distances also land on every shift card on the page ([data-ev-distance]).
// Leaflet and the OpenStreetMap tiles load only when the map scrolls near (or
// when someone presses the button first).
import { upcoming, stamp, timeRange, pick, actionHref, mapHref, startDate } from '../data/events.js';

const points = upcoming()
  .filter((e) => e.geo)
  .map((e) => ({
    id: e.id,
    expires: e.expires,
    slate: Boolean(e.slate),
    lat: e.geo.lat,
    lng: e.geo.lng,
    title: e.title,
    start: e.start,
    date: startDate(e),
    day: {
      en: `${stamp(e, 'en').weekdayLong}, ${stamp(e, 'en').day}`,
      es: `${stamp(e, 'es').weekdayLong} ${stamp(e, 'es').day}`,
    },
    time: { en: timeRange(e, 'en'), es: timeRange(e, 'es') },
    when: {
      en: [`${stamp(e, 'en').weekdayLong}, ${stamp(e, 'en').day}`, timeRange(e, 'en')].filter(Boolean).join(' · '),
      es: [`${stamp(e, 'es').weekdayLong} ${stamp(e, 'es').day}`, timeRange(e, 'es')].filter(Boolean).join(' · '),
    },
    place: { en: pick(e.location, 'en'), es: pick(e.location, 'es') },
    address: e.address,
    // No outside RSVP page: that day in the list below, where the card's own
    // "I'm coming" form takes the sign-up.
    href: actionHref(e, `#cal-${startDate(e)}`),
    action: e.action,
    directions: mapHref(e),
  }));
---

{points.length > 0 && (
<div class="smap" id="map" data-smap>
  <div class="smap-head">
    <div>
      <span class="section-label" data-i18n="events.map_label">Shift Map</span>
      <h3 class="smap-title" data-i18n="events.map_headline">How Far Is the Next Shift?</h3>
      <p class="smap-sub" data-i18n="events.map_sub">Every upcoming shift with an address, on one map. Tap a pin for the time and the RSVP.</p>
    </div>
    <div class="smap-locate">
      <button type="button" class="btn btn-orange smap-btn" data-smap-locate>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="7"/></svg>
        <span data-i18n="events.map_locate">Show distances from me</span>
      </button>
      <p class="smap-privacy" data-i18n="events.map_privacy">Worked out in your browser. We never see or store your location. The map tiles for your area come from OpenStreetMap.</p>
    </div>
  </div>

  <p class="smap-status" data-smap-status aria-live="polite"></p>

  <div class="smap-frame">
    <div class="smap-canvas" data-smap-canvas role="region" aria-label="Map of upcoming shifts"></div>
    <ul class="smap-legend">
      <li><span class="smap-dot smap-dot-ward" aria-hidden="true"></span><span data-i18n="events.map_legend_ward">25th Ward shift</span></li>
      <li><span class="smap-dot smap-dot-slate" aria-hidden="true"></span><span data-i18n="events.map_legend_slate">Socialist Slate canvass</span></li>
    </ul>
  </div>

  <div class="smap-nearest" data-smap-nearest hidden>
    <h4 class="smap-nearest-title" data-i18n="events.map_nearest">Closest to you</h4>
    <ol class="smap-nearest-list" data-smap-nearest-list></ol>
  </div>

  <script type="application/json" data-smap-data set:html={JSON.stringify(points)} />
  {/* English fallbacks for strings the script writes into the map (read through tr()). */}
  <template data-smap-strings>
    <span data-i18n="events.map_ctl_locate">Show my location on the map</span>
    <span data-i18n="events.map_ctl_all">Show all shifts</span>
    <span data-i18n="events.map_count">{'{n}'} shifts here</span>
    <span data-i18n="events.map_pop_list">Shifts at this location</span>
    <span data-i18n="events.map_done">You are the blue dot. Distances are on every pin and shift card.</span>
    <span data-i18n="events.map_far">You are about {'{d}'} miles from the nearest shift, so the map stays on the shifts.</span>
  </template>
</div>
)}

<script>
  import en from '../i18n/en.json';
  import es from '../i18n/es.json';
  import { isPast } from '../scripts/events-client.js';

  const root = document.querySelector('[data-smap]');
  if (root) init(root);

  function init(root) {
    const lang = () => {
      try { return localStorage.getItem('bsl-lang') === 'es' ? 'es' : 'en'; } catch { return 'en'; }
    };
    const tr = (key) => (lang() === 'es' ? es : en).events[key] || en.events[key];
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

    const all = JSON.parse(root.querySelector('[data-smap-data]').textContent || '[]');
    const points = all.filter((p) => !isPast(p.expires));
    if (!points.length) { root.hidden = true; return; }

    // One pin per address; several shifts at the same door share it.
    const groups = [];
    const byKey = new Map();
    points.forEach((p) => {
      // About 100 m: 2100 and 2102 W Cermak share one pin.
      const key = `${p.lat.toFixed(3)},${p.lng.toFixed(3)}`;
      if (!byKey.has(key)) { const g = { lat: p.lat, lng: p.lng, items: [] }; byKey.set(key, g); groups.push(g); }
      byKey.get(key).items.push(p);
    });

    const canvas = root.querySelector('[data-smap-canvas]');
    const status = root.querySelector('[data-smap-status]');
    const btn = root.querySelector('[data-smap-locate]');
    const nearest = root.querySelector('[data-smap-nearest]');
    const nearestList = root.querySelector('[data-smap-nearest-list]');
    let L = null;
    let map = null;
    let building = null; // the build() promise, so two callers share one build
    let me = null; // { lat, lng, acc } once the visitor shares it
    let meMarker = null;
    let meRing = null; // faint accuracy circle when the fix is rough
    let locating = false;
    let ctlLocate = null;
    let ctlAll = null;
    const markers = new Map();
    let statusKey = null;
    let statusVars = null;
    // Farther than this from the nearest shift, the map stays on the shifts.
    const FAR_MI = 60;
    const FIT = { padding: [28, 28], maxZoom: 14 };

    // Straight-line distance in miles.
    function miles(a, b) {
      const R = 3958.8;
      const rad = (d) => (d * Math.PI) / 180;
      const dLat = rad(b.lat - a.lat);
      const dLng = rad(b.lng - a.lng);
      const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLng / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(h));
    }
    function fmt(mi) {
      const n = mi < 10 ? (Math.round(mi * 10) / 10).toFixed(1) : String(Math.round(mi));
      return tr('map_mi').replace('{d}', n);
    }

    // "Sweet Bean, 1152 S Wabash Ave, Chicago"; just the address when the place name is the address.
    function where(p, l) {
      if (!p.address) return p.place[l];
      return p.address.startsWith(p.place[l]) ? p.address : `${p.place[l]}, ${p.address}`;
    }

    // Popup height budget: the whole popup stays within POP_SHARE of the map
    // canvas, so it always fits and autoPan only nudges the view. The header
    // (place, count, distance, Directions) stays put; the shift list scrolls.
    const POP_SHARE = 0.6;
    const POP_CHROME = 36; // content margins, the list rule and a little air
    let popHeadH = 120; // cautious guess until the open popup is measured

    function listMax() {
      const h = canvas.clientHeight || 400;
      return Math.max(72, Math.floor(h * POP_SHARE) - popHeadH - POP_CHROME);
    }

    function popupEl(g) {
      const l = lang();
      const first = g.items[0];
      // One door: place in the header. Neighbouring doors: place on each shift.
      const onePlace = g.items.every((p) => p.address === first.address && p.place[l] === first.place[l]);
      const n = g.items.length;
      const sorted = [...g.items].sort((a, b) => String(a.start).localeCompare(String(b.start)));
      // One heading per date, then one compact row per shift.
      const days = [];
      sorted.forEach((p) => {
        const last = days[days.length - 1];
        if (last && last.date === p.date) last.items.push(p);
        else days.push({ date: p.date, label: p.day[l], items: [p] });
      });
      const rows = days.map((d) => `<li class="smap-pop-day">
          <p class="smap-pop-dayname">${esc(d.label)}</p>
          <ul class="smap-pop-rows">${d.items.map((p) => {
            const ext = /^https?:/.test(p.href);
            return `<li class="smap-pop-item">
              <span class="smap-pop-when">${esc(p.time[l] || p.when[l])}${p.slate ? ` <span class="smap-pop-tag">${esc(tr('slate_tag'))}</span>` : ''}</span>
              <a class="smap-pop-btn" href="${esc(p.href)}"${ext ? ' target="_blank" rel="noopener noreferrer"' : ''}>${esc(p.action[l])}</a>
              <strong class="smap-pop-title">${esc(p.title[l])}</strong>
              ${onePlace ? '' : `<span class="smap-pop-where">${esc(where(p, l).replace(/, Chicago(, IL)?$/i, ''))}</span>`}
            </li>`;
          }).join('')}</ul>
        </li>`).join('');
      const meta = [
        n > 1 ? `<span class="smap-pop-count">${esc(tr('map_count').replace('{n}', n))}</span>` : '',
        me ? `<span class="smap-pop-dist">${esc(fmt(miles(me, g)))}</span>` : '',
      ].filter(Boolean).join('<span aria-hidden="true"> · </span>');
      const el = document.createElement('div');
      el.className = 'smap-pop';
      el.innerHTML = `<div class="smap-pop-head">
          ${onePlace ? `<p class="smap-pop-place">${esc(first.place[l])}</p>
          ${first.address && !first.address.startsWith(first.place[l]) ? `<p class="smap-pop-addr">${esc(first.address)}</p>` : ''}` : ''}
          ${meta ? `<p class="smap-pop-meta">${meta}</p>` : ''}
          ${first.directions ? `<a class="smap-pop-dir" href="${esc(first.directions)}" target="_blank" rel="noopener noreferrer">${esc(tr('map_directions'))}</a>` : ''}
        </div>
        <div class="smap-pop-listwrap">
          <ul class="smap-pop-items" tabindex="0" aria-label="${esc(tr('map_pop_list'))}">${rows}</ul>
        </div>`;
      const list = el.querySelector('.smap-pop-items');
      const wrap = el.querySelector('.smap-pop-listwrap');
      list.style.maxHeight = `${listMax()}px`;
      // Soft fade at the bottom while more of the list is below.
      const cue = () => wrap.classList.toggle('has-more', list.scrollTop + list.clientHeight < list.scrollHeight - 2);
      list.addEventListener('scroll', cue, { passive: true });
      requestAnimationFrame(cue);
      // A focused link scrolls into view inside the list (keyboard users).
      list.addEventListener('focusin', (ev) => { if (ev.target !== list) ev.target.scrollIntoView({ block: 'nearest' }); });
      L.DomEvent.disableScrollPropagation(el);
      L.DomEvent.disableClickPropagation(el);
      return el;
    }

    // Re-render an open popup (language, distances, size) without replacing the
    // bound content function.
    function refreshOpenPopups() {
      if (map) groups.forEach((g) => { const m = markers.get(g); if (m && m.isPopupOpen()) { m.getPopup().update(); fitPopup(m.getPopup()); } });
    }
    function fitPopup(popup) {
      const head = popup.getElement()?.querySelector('.smap-pop-head');
      if (!head) return;
      const h = head.offsetHeight;
      if (Math.abs(h - popHeadH) > 4) { popHeadH = h; popup.update(); }
    }

    function pinIcon(g) {
      const slate = g.items.every((p) => p.slate);
      const n = g.items.length;
      return L.divIcon({
        className: 'smap-pin-wrap',
        html: `<span class="smap-pin ${slate ? 'smap-pin-slate' : 'smap-pin-ward'}">${n > 1 ? `<b>${n}</b>` : ''}</span>`,
        iconSize: [30, 30],
        iconAnchor: [15, 30],
        popupAnchor: [0, -28],
      });
    }

    const CROSSHAIR = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="7"/></svg>';
    const FRAME = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg>';

    function labelControls() {
      [[ctlLocate, 'map_ctl_locate'], [ctlAll, 'map_ctl_all']].forEach(([b, key]) => {
        if (!b) return;
        b.setAttribute('aria-label', tr(key));
        b.title = tr(key);
      });
    }

    function build() {
      if (!building) building = buildMap();
      return building;
    }

    async function buildMap() {
      const [mod] = await Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')]);
      L = mod.default || mod;
      map = L.map(canvas, { scrollWheelZoom: false, zoomControl: true, zoomSnap: 0.25, zoomDelta: 0.5 });
      // Locate and "all shifts" buttons, stacked under the zoom buttons (top-left).
      const Ctl = L.Control.extend({
        options: { position: 'topleft' },
        onAdd() {
          const bar = L.DomUtil.create('div', 'leaflet-bar smap-ctl');
          ctlLocate = L.DomUtil.create('button', 'smap-ctl-btn smap-ctl-locate', bar);
          ctlLocate.type = 'button';
          ctlLocate.innerHTML = CROSSHAIR;
          ctlAll = L.DomUtil.create('button', 'smap-ctl-btn smap-ctl-all', bar);
          ctlAll.type = 'button';
          ctlAll.innerHTML = FRAME;
          ctlAll.hidden = true; // only useful once the view has moved to the visitor
          labelControls();
          L.DomEvent.disableClickPropagation(bar);
          ctlLocate.addEventListener('click', () => locate());
          ctlAll.addEventListener('click', () => fitAll());
          return bar;
        },
      });
      new Ctl().addTo(map);
      if (locating) setBusy(true);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      }).addTo(map);
      groups.forEach((g) => {
        const m = L.marker([g.lat, g.lng], {
          icon: pinIcon(g),
          title: g.items[0].place[lang()],
          alt: g.items[0].place[lang()],
          keyboard: true,
        }).addTo(map);
        m.bindPopup(() => popupEl(g), {
          maxWidth: 280,
          minWidth: 220,
          className: 'smap-popup',
          // Clear of the zoom and locate buttons on the left.
          autoPanPaddingTopLeft: [52, 12],
          autoPanPaddingBottomRight: [12, 12],
        });
        markers.set(g, m);
      });
      // Measure the real header once a popup is open; re-fit if the guess was off.
      map.on('popupopen', (ev) => fitPopup(ev.popup));
      map.on('resize', refreshOpenPopups);
      fitAll();
      if (me) addMe();
    }

    const shiftBounds = () => L.latLngBounds(groups.map((g) => [g.lat, g.lng]));
    function fitAll() {
      if (map) map.fitBounds(shiftBounds(), FIT);
    }

    // The visitor: a blue dot with a white ring and a soft halo, above the pins.
    function addMe() {
      if (!map || !me) return;
      if (meMarker) { meMarker.setLatLng([me.lat, me.lng]); }
      else {
        meMarker = L.marker([me.lat, me.lng], {
          icon: L.divIcon({
            className: 'smap-me-wrap',
            html: '<span class="smap-me"><span class="smap-me-halo"></span><span class="smap-me-dot"></span></span>',
            iconSize: [36, 36],
            iconAnchor: [18, 18],
            tooltipAnchor: [14, 0],
          }),
          keyboard: true, // focusable; Leaflet opens the tooltip on focus
          title: tr('map_you'),
          zIndexOffset: 1000,
        }).addTo(map).bindTooltip(tr('map_you'), { direction: 'right' });
        labelMe();
      }
      if (meRing) { meRing.remove(); meRing = null; }
      if (me.acc > 150) {
        meRing = L.circle([me.lat, me.lng], {
          radius: me.acc, interactive: false, color: '#036d99', weight: 1, opacity: 0.35, fillColor: '#036d99', fillOpacity: 0.07,
        }).addTo(map);
      }
    }
    function labelMe() {
      if (!meMarker) return;
      meMarker.setTooltipContent(tr('map_you'));
      const el = meMarker.getElement();
      if (el) { el.setAttribute('aria-label', tr('map_you')); el.title = tr('map_you'); }
    }

    // Move the view so the visitor and the shifts are both on screen.
    function showMe() {
      if (!map || !me) return;
      const nearestMi = Math.min(...groups.map((g) => miles(me, g)));
      if (nearestMi > FAR_MI) {
        fitAll();
        setStatus('map_far', { d: Math.round(nearestMi).toLocaleString('en-US') });
      } else {
        map.fitBounds(shiftBounds().extend([me.lat, me.lng]), FIT);
        setStatus('map_done');
      }
      if (ctlAll) ctlAll.hidden = nearestMi > FAR_MI; // the view never left the shifts
    }

    function setBusy(on) {
      btn.disabled = on;
      if (!ctlLocate) return;
      ctlLocate.classList.toggle('is-busy', on);
      ctlLocate.setAttribute('aria-busy', on ? 'true' : 'false');
    }

    // Both entry points: the header button and the on-map control.
    async function locate() {
      if (me) { await build(); addMe(); showMe(); return; }
      if (locating) return;
      if (!('geolocation' in navigator)) { setStatus('map_unsupported'); return; }
      locating = true;
      setBusy(true);
      setStatus('map_locating');
      build(); // start loading the map while the browser asks
      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          me = { lat: pos.coords.latitude, lng: pos.coords.longitude, acc: pos.coords.accuracy || 0 };
          paintDistances();
          await build();
          locating = false;
          setBusy(false);
          addMe();
          showMe();
        },
        () => {
          locating = false;
          setBusy(false);
          setStatus('map_denied');
        },
        { enableHighAccuracy: false, timeout: 15000, maximumAge: 300000 },
      );
    }

    // Load the map library and tiles only when the map comes near the screen.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((x) => x.isIntersecting)) { io.disconnect(); build(); }
      }, { rootMargin: '400px' });
      io.observe(canvas);
    } else {
      build();
    }

    function setStatus(key, vars = null) {
      statusKey = key;
      statusVars = vars;
      let text = key ? tr(key) : '';
      if (vars) Object.entries(vars).forEach(([k, v]) => { text = text.replace(`{${k}}`, v); });
      status.textContent = text;
    }

    function paintDistances() {
      if (!me) return;
      // Every shift card on the page.
      document.querySelectorAll('.ev-card[data-event-id]').forEach((card) => {
        const p = points.find((x) => x.id === card.getAttribute('data-event-id'));
        const chip = card.querySelector('[data-ev-distance]');
        if (!p || !chip) return;
        chip.textContent = fmt(miles(me, p));
        chip.hidden = false;
      });
      // The closest five shifts, nearest first.
      const l = lang();
      const ranked = points.map((p) => ({ p, d: miles(me, p) })).sort((a, b) => a.d - b.d).slice(0, 5);
      nearestList.innerHTML = ranked.map(({ p, d }) => `<li>
        <button type="button" class="smap-near-btn" data-smap-open="${esc(p.id)}">
          <span class="smap-near-dist">${esc(fmt(d))}</span>
          <span class="smap-near-title">${p.slate ? `<span class="smap-pop-tag">${esc(tr('slate_tag'))}</span> ` : ''}${esc(p.title[l])}</span>
          <span class="smap-near-when">${esc(p.when[l])} · ${esc(p.place[l])}</span>
        </button>
      </li>`).join('');
      nearest.hidden = false;
      refreshOpenPopups();
    }

    nearestList.addEventListener('click', async (ev) => {
      const b = ev.target.closest('[data-smap-open]');
      if (!b) return;
      await build();
      const g = groups.find((x) => x.items.some((p) => p.id === b.getAttribute('data-smap-open')));
      const m = g && markers.get(g);
      if (!m) return;
      canvas.scrollIntoView({ behavior: 'smooth', block: 'center' });
      map.setView(m.getLatLng(), Math.max(map.getZoom(), 14));
      m.openPopup();
    });

    btn.addEventListener('click', () => locate());

    document.addEventListener('bsl:langchange', () => setTimeout(() => {
      if (statusKey) setStatus(statusKey, statusVars);
      labelControls();
      labelMe();
      canvas.setAttribute('aria-label', tr('map_region'));
      if (me) paintDistances();
      refreshOpenPopups();
    }, 0));
    canvas.setAttribute('aria-label', tr('map_region'));
  }
</script>

<style is:global>
  /* First block of the /volunteer Show Up section, above the calendar. */
  .smap {
    margin: var(--space-lg, 24px) 0 var(--space-2xl, 48px);
    scroll-margin-top: 90px;
  }
  .smap-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md, 16px) var(--space-lg, 24px);
    margin-bottom: var(--space-md, 16px);
  }
  .smap-head .section-label {
    display: block;
  }
  .smap-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--blue-deeper);
    margin: 4px 0 6px;
  }
  .smap-sub {
    max-width: 560px;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--gray-700);
  }
  .smap-locate {
    max-width: 340px;
  }
  .smap-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .smap-btn[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
