---
// /canvass/: the canvass team, for people who cannot make the dated shifts
// and tell us when they are free to knock doors. Replaces the link out to the
// Google Form (https://forms.gle/aBc3EsoUhraW2A4Q8); responses still land in
// that same form. Linked from Show Up (#canvass-team on /volunteer, the
// "Can't make these?" line on home) and /links.
// Form and its rules: src/components/canvass/TeamForm.astro. Intro copy is
// the campaign's own words from the Google Form's description.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TeamForm from '../components/canvass/TeamForm.astro';
---

<Layout
  title="Join the Canvass Team | Byron Sigcho-Lopez for 25th Ward Alderman"
  description="Can't make the dated canvass shifts? Tell us when you are free to knock doors in the 25th Ward and join the canvass team to re-elect Byron Sigcho-Lopez on February 23, 2027."
>
  <Navbar />
  <main>
    <section class="cvp" aria-labelledby="cvp-head">
      <div class="container cvp-in">
        <header class="cvp-intro">
          <p class="cvp-motto"><span data-i18n="canvass.motto">Not me, but we.</span></p>
          <h1 class="cvp-head" id="cvp-head" data-i18n="canvass.head">Join the Canvass Team</h1>
          <p class="cvp-lead" data-i18n="canvass.lead">Can't make the dated shifts? Tell us when you are free to knock doors, and the campaign will follow up.</p>
          <p class="cvp-body" data-i18n="canvass.body">We are building a mass movement to send Byron Sigcho-Lopez, a proven fighter for our people, back to City Council, and to defend our community from big corporations and the billionaire class.</p>
          <p class="cvp-date"><span data-i18n="meet.road_ward">25th Ward: February 23, 2027</span></p>
        </header>

        <TeamForm />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cvp {
    padding: calc(var(--nav-height) + var(--space-2xl)) 0 var(--space-4xl);
    background: var(--cream);
    overflow-x: clip;
  }

  .cvp-in {
    max-width: 920px;
  }

  .cvp-intro {
    max-width: 40rem;
    margin: 0 0 var(--space-2xl);
  }

  .cvp-motto {
    display: inline-block;
    margin: 0 0 var(--space-md);
    rotate: -2deg;
  }

  .cvp-motto span {
    display: inline-block;
    padding: 0.25em 0.7em;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream-light);
    background: var(--blue-deeper);
    box-shadow: 3px 3px 0 var(--orange);
  }

  .cvp-head {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    color: #142749;
    text-shadow: 0.05em 0.05em 0 var(--orange);
    text-wrap: balance;
  }

  .cvp-lead {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    line-height: 1.25;
    color: #142749;
  }

  .cvp-body {
    margin: 0 0 var(--space-md);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--gray-700);
  }

  .cvp-date {
    margin: 0;
  }

  .cvp-date span {
    display: inline-block;
    padding: 3px 10px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange-dark);
    border: 2px dashed rgba(230, 136, 28, 0.55);
    border-radius: 3px;
    rotate: -1deg;
  }

  @media (max-width: 768px) {
    .cvp {
      padding: calc(var(--nav-height) + var(--space-xl)) 0 var(--space-3xl);
    }

    .cvp-intro {
      margin-bottom: var(--space-xl);
    }
  }
</style>
