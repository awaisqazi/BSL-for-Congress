---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ShowUp from '../components/ShowUp.astro';
import ThePromise from '../components/ThePromise.astro';
import MeetOrganizer from '../components/MeetOrganizer.astro';
import PlatformGrid from '../components/PlatformGrid.astro';
import UpNext from '../components/UpNext.astro';
import AnointmentBanner from '../components/AnointmentBanner.astro';
import LatestStrip from '../components/LatestStrip.astro';
import RoadCTA from '../components/RoadCTA.astro';
import NextUp from '../components/NextUp.astro';
import SolidarityTicker from '../components/SolidarityTicker.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <ShowUp />
    <ThePromise />
    <MeetOrganizer />
    <PlatformGrid />
    <UpNext />
    <LatestStrip />
    <AnointmentBanner />
    <NextUp />
    <RoadCTA />
    <SolidarityTicker />
  </main>
  <Footer />
</Layout>
