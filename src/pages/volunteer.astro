---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import VolunteerHero from '../components/volunteer/VolunteerHero.astro';
import ThisWeek from '../components/volunteer/ThisWeek.astro';
import RolePicker from '../components/volunteer/RolePicker.astro';
import SignupForm from '../components/volunteer/SignupForm.astro';
import ActionBlocks from '../components/volunteer/ActionBlocks.astro';
import PetitionBlitz from '../components/volunteer/PetitionBlitz.astro';
import NextUp from '../components/NextUp.astro';
import FundCTA from '../components/volunteer/FundCTA.astro';
import SolidarityTicker from '../components/SolidarityTicker.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Volunteer | Byron Sigcho-Lopez, 25th Ward Alderman" description="Knock doors with us. Sundays on the doors, Tuesdays at Ward Night, and a sign-up that places you. Re-elect Byron Sigcho-Lopez in the 25th Ward on February 23, 2027.">
  <Navbar />
  <main>
    <!-- Ask, then the two standing shifts, then the picker that feeds the form.
         Roles, the story, the full calendar and the donate ask come after. -->
    <VolunteerHero />
    <ThisWeek />
    <RolePicker />
    <SignupForm />
    <ActionBlocks />
    <PetitionBlitz />
    <NextUp />
    <FundCTA />
    <SolidarityTicker />
  </main>
  <Footer />
</Layout>
