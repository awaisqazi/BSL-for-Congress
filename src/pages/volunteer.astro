---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import VolunteerHero from '../components/volunteer/VolunteerHero.astro';
import PetitionBlitz from '../components/volunteer/PetitionBlitz.astro';
import RolePicker from '../components/volunteer/RolePicker.astro';
import ActionBlocks from '../components/volunteer/ActionBlocks.astro';
import SignupForm from '../components/volunteer/SignupForm.astro';
import SolidarityTicker from '../components/SolidarityTicker.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Volunteer | Byron Sigcho-Lopez for Congress" description="Join the fight to keep Byron on the ballot in IL-04. The machine filed an objection to throw out 22,788 signatures. Spread the word, canvass, phonebank, and defend your choice in November.">
  <Navbar />
  <main>
    <VolunteerHero />
    <PetitionBlitz />
    <RolePicker />
    <ActionBlocks />
    <SignupForm />
    <SolidarityTicker />
  </main>
  <Footer />
</Layout>
