---
// The one action page. Show Up (every dated shift, the month calendar, the
// standing shifts and the official dates) comes right after a short hero;
// /events/ redirects here (#show-up). Then the ways to help, the petition,
// the sign-up form (#signup) and the donate ask.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import VolunteerHero from '../components/volunteer/VolunteerHero.astro';
import ShowUp from '../components/ShowUp.astro';
import RolePicker from '../components/volunteer/RolePicker.astro';
import ActionBlocks from '../components/volunteer/ActionBlocks.astro';
import PetitionBlitz from '../components/volunteer/PetitionBlitz.astro';
import SignupForm from '../components/volunteer/SignupForm.astro';
import FundCTA from '../components/volunteer/FundCTA.astro';
import SolidarityTicker from '../components/SolidarityTicker.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Show Up and Volunteer | Byron Sigcho-Lopez, 25th Ward Alderman" description="Every petition canvass, Ward Night and official date on the road to February 23, 2027, and a sign-up that places you. Knock doors with us and re-elect Byron Sigcho-Lopez in the 25th Ward.">
  <Navbar />
  <main>
    <VolunteerHero />
    <ShowUp full />
    <RolePicker />
    <ActionBlocks />
    <PetitionBlitz />
    <SignupForm />
    <FundCTA />
    <SolidarityTicker />
  </main>
  <Footer />
</Layout>
