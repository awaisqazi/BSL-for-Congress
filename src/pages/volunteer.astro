---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import VolunteerHero from '../components/volunteer/VolunteerHero.astro';
import PetitionBlitz from '../components/volunteer/PetitionBlitz.astro';
import RolePicker from '../components/volunteer/RolePicker.astro';
import ActionBlocks from '../components/volunteer/ActionBlocks.astro';
import SignupForm from '../components/volunteer/SignupForm.astro';
import SolidarityTicker from '../components/SolidarityTicker.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Volunteer | Byron Sigcho-Lopez, 25th Ward Alderman" description="This summer, machine lawyers kept his name off a congressional ballot. The 25th Ward writes a different story. Join the campaign, knock doors, and re-elect Byron on February 23, 2027.">
  <Navbar />
  <main>
    <VolunteerHero />
    <PetitionBlitz />
    <RolePicker />
    <ActionBlocks />
    <SignupForm />
    <SolidarityTicker />
  </main>
  <Footer />
</Layout>
