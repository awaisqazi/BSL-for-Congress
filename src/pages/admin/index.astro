      .adm-group-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px var(--space-md);
        margin-bottom: var(--space-sm);
      }

      .adm-group-title {
        font-family: var(--font-display);
        font-size: var(--text-lg);
        font-weight: 900;
        color: var(--blue-deeper);
        display: flex;
        flex-wrap: wrap;
        gap: 4px 10px;
        align-items: baseline;
      }

      .adm-group-date {
        font-size: var(--text-xs);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--orange-dark);
        border: 2px dashed rgba(230, 136, 28, 0.6);
        padding: 0 8px;
        rotate: -1.5deg;
      }

      .adm-group-count {
        font-size: var(--text-sm);
        color: var(--gray-700);
      }

      @media (max-width: 1024px) {
        .adm-summary {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      /* Phones: each row becomes a small card */
      @media (max-width: 760px) {
        .adm-wrap {
          padding: var(--space-lg) 16px var(--space-2xl);
        }

        .adm-placard {
          font-size: var(--text-xl);
        }

        .adm-narrow {
          margin-top: var(--space-lg);
          rotate: 0deg;
        }

        .adm-summary {
          gap: var(--space-sm);
        }

        .adm-stat {
          padding: var(--space-sm);
        }

        .adm-stat-nums dd {
          font-size: var(--text-xl);
        }

        .adm-toolbar-btns {
          margin-left: 0;
          width: 100%;
        }

        .adm-toolbar-btns .adm-btn {
          flex: 1;
        }

        .adm-sheet {
          background: none;
          box-shadow: none;
          overflow: visible;
        }

        .adm-table thead {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
        }

        .adm-table,
        .adm-table tbody,
        .adm-table tr,
        .adm-table td {
          display: block;
          width: 100%;
        }

        .adm-table tr {
          background: var(--white);
          box-shadow: var(--shadow-sm);
          margin-bottom: var(--space-sm);
          padding: 6px 0;
          border-top: 3px solid var(--blue);
        }

        .adm-table td {
          display: grid;
          grid-template-columns: 96px minmax(0, 1fr);
          gap: 8px;
          border-bottom: none;
          padding: 4px 12px;
        }

        .adm-table td::before {
          content: attr(data-label);
          font-family: var(--font-display);
          font-size: 0.68rem;
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: 0.06em;
          color: var(--blue-deeper);
          padding-top: 2px;
        }

        .adm-table td:first-child {
          font-weight: 700;
          font-size: 0.95rem;
        }

        .adm-td-status,
        .adm-td-notes,
        .adm-td-contact {
          min-width: 0;
        }

        .adm-nowrap {
          white-space: normal;
        }

        .adm-td-status > *,
        .adm-td-notes > * {
          grid-column: 2;
        }
      }
    </style>
  </body>
</html>
