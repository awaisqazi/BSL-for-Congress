---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MachineHero from '../components/machine/MachineHero.astro';
import TheDuel from '../components/machine/TheDuel.astro';
import BattleTimeline from '../components/machine/BattleTimeline.astro';
import MachineSection from '../components/machine/MachineSection.astro';
import MovementSection from '../components/machine/MovementSection.astro';
import VoicesWall from '../components/VoicesWall.astro';
import SolidarityTicker from '../components/SolidarityTicker.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Machine vs. Movement | Re-elect Byron Sigcho-Lopez, 25th Ward" description="The machine handed a Congressional seat over in a backroom, and when 22,788 voters answered, it sent lawyers and won. You cannot disqualify a neighborhood. The whole saga, and the road to February 23, 2027.">
  <Navbar />
  <main>
    <MachineHero />
    <TheDuel />
    <BattleTimeline />
    <MachineSection />
    <MovementSection />
    <VoicesWall voices={['jesse', 'farah', 'lee']} />
    <SolidarityTicker />
  </main>
  <Footer />
</Layout>
