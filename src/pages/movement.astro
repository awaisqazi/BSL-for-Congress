---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MachineHero from '../components/machine/MachineHero.astro';
import TheDuel from '../components/machine/TheDuel.astro';
import BattleTimeline from '../components/machine/BattleTimeline.astro';
import MachineSection from '../components/machine/MachineSection.astro';
import MovementSection from '../components/machine/MovementSection.astro';
import VoicesWall from '../components/VoicesWall.astro';
import SolidarityTicker from '../components/SolidarityTicker.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Machine vs. Movement | Byron Sigcho-Lopez for Congress" description="The machine handed a Congressional seat over in a backroom, and when 22,788 voters answered, it sent lawyers. Follow the duel, the ballot battle timeline, and join the defense.">
  <Navbar />
  <main>
    <MachineHero />
    <TheDuel />
    <BattleTimeline />
    <MachineSection />
    <MovementSection />
    <VoicesWall voices={['jesse', 'farah', 'lee']} />
    <SolidarityTicker />
  </main>
  <Footer />
</Layout>
