---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MachineHero from '../components/machine/MachineHero.astro';
import TheDuel from '../components/machine/TheDuel.astro';
import BattleTimeline from '../components/machine/BattleTimeline.astro';
import MachineSection from '../components/machine/MachineSection.astro';
import MovementSection from '../components/machine/MovementSection.astro';
import VoicesWall from '../components/VoicesWall.astro';
import SolidarityTicker from '../components/SolidarityTicker.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Machine vs. Movement | Re-elect Byron Sigcho-Lopez, 25th Ward" description="Who does your alderman work for? For 23 years the 25th Ward belonged to the machine. In 2019 the ward took itself back. The record, the fights, and the road to February 23, 2027.">
  <Navbar />
  <main>
    <MachineHero />
    <TheDuel />
    <BattleTimeline />
    <MachineSection />
    <MovementSection />
    <VoicesWall voices={['jesse', 'farah', 'lee']} />
    <SolidarityTicker />
  </main>
  <Footer />
</Layout>
