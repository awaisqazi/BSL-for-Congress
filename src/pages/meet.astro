---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MeetHero from '../components/meet/MeetHero.astro';
import RoadMarker from '../components/meet/RoadMarker.astro';
import EarlyLife from '../components/meet/EarlyLife.astro';
import WardRecord from '../components/meet/WardRecord.astro';
import Lineage from '../components/meet/Lineage.astro';
import SocialistValues from '../components/meet/SocialistValues.astro';
import VoicesWall from '../components/VoicesWall.astro';
import RoadCTA from '../components/RoadCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Meet Byron | Byron Sigcho-Lopez for 25th Ward Alderman" description="From Ecuador to Chicago's 25th Ward. Meet Byron Sigcho-Lopez, the independent democratic socialist running for re-election as Alderman of the 25th Ward.">
  <Navbar />
  <main>
    <MeetHero />
    <RoadMarker i18nKey="meet.road_quito" label="Quito, Ecuador" icon="🌎" />
    <EarlyLife />
    <RoadMarker i18nKey="meet.road_pilsen" label="Pilsen, Chicago" icon="🏘️" />
    <WardRecord />
    <RoadMarker i18nKey="meet.road_cityhall" label="City Hall, 25th Ward" icon="🏛️" />
    <Lineage />
    <SocialistValues />
    <VoicesWall />
    <RoadMarker i18nKey="meet.road_ward" label="25th Ward: February 23, 2027" icon="🗳️" />
    <RoadCTA />
  </main>
  <Footer />
</Layout>
