# Copy to .env (git-ignored) for local dev. In CI these come from GitHub
# repository *variables* (Settings > Secrets and variables > Actions > Variables).
# Both values are public by design: the key is the project's publishable
# (anon) key, and Row Level Security only lets it INSERT.
# NEVER put the service_role / secret key here or anywhere in the site.
# If either value is missing, the site skips Supabase writes and the Google
# Forms keep working exactly as today.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
